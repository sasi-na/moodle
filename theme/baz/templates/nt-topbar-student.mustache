{{!
    @template theme_baz/nt-topbar-student

    "New theme" two-level top bar for the student dashboard.
}}
<header class="nt-top" id="nt-shellbar">
    <div class="nt-top-inner">
        <a class="nt-brand" href="{{{ config.wwwroot }}}/my/">
            {{#customsidebarlogo}}<img src="{{customsidebarlogo}}" alt="{{sitename}}">{{/customsidebarlogo}}
            {{^customsidebarlogo}}{{#customlogo}}<img src="{{customlogo}}" alt="{{sitename}}">{{/customlogo}}{{^customlogo}}<span>{{{ sitename }}}</span>{{/customlogo}}{{/customsidebarlogo}}
        </a>
        <nav class="nt-nav" aria-label="{{#str}}nt_mainnav, theme_baz{{/str}}">
            <a href="{{{ config.wwwroot }}}/my/" class="on" aria-current="page"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2"/></svg>{{#str}}sd_nav_dashboard, theme_baz{{/str}}</a>
            <a href="{{coursesurl}}"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="13" rx="1.5"/><path d="M3 20h18"/></svg>{{#str}}sd_nav_courses, theme_baz{{/str}}</a>
            <a href="{{calendarurl}}"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>{{#str}}sd_nav_calendar, theme_baz{{/str}}</a>
            <a href="{{{ config.wwwroot }}}/grade/report/overview/index.php"><svg viewBox="0 0 24 24"><path d="M12 3l7 3.5v5c0 4.5-3 7.5-7 8.5-4-1-7-4-7-8.5v-5z"/></svg>{{#str}}sd_nav_grades, theme_baz{{/str}}</a>
            {{#hasinterestzone}}<a href="{{interestzoneurl}}"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 11v5"/><circle cx="12" cy="8" r=".6" fill="currentColor"/></svg>{{interestzonelabel}}</a>{{/hasinterestzone}}
            {{#showeidcard}}<a href="{{eidcardurl}}"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="11" r="2"/><path d="M13 10h5M13 14h3"/></svg>{{#str}}pluginname, local_studentid{{/str}}</a>{{/showeidcard}}
            <a href="{{{ config.wwwroot }}}/user/files.php"><svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4.5l2 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>{{#str}}sd_nav_files, theme_baz{{/str}}</a>
        </nav>
        <div class="nt-top-right">
            <div class="sd-search-wrap nt-search-wrap" data-suggest="{{searchitemsjson}}">
                <form class="nt-search" action="{{{ config.wwwroot }}}/course/search.php" method="get" role="search">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="text" name="search" id="sd-search-input" autocomplete="off" placeholder="{{#str}}sd_searchph, theme_baz{{/str}}" aria-label="{{#str}}search, core{{/str}}">
                    <span class="nt-kbd">/</span>
                </form>
                <div class="sd-suggest" id="sd-suggest" hidden></div>
            </div>
            {{#hasaskjo}}<button type="button" class="nt-askjo" id="sd-askjo-btn"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>{{#str}}sd_askjo, theme_baz{{/str}}</button>{{/hasaskjo}}
            <button type="button" class="nt-iconbtn" id="sd-themebtn" title="{{#str}}sd_toggletheme, theme_baz{{/str}}">
                <svg id="sd-themeicon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
            <div class="nt-editswitch">{{{ output.edit_switch }}}</div>
            <div class="nt-plugins nt-actions">{{{ output.navbar_plugin_output }}}</div>
            <div class="nt-usermenu">{{{ output.user_menu }}}</div>
        </div>
    </div>
</header>

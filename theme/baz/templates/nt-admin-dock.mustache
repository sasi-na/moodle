{{!
    @template theme_baz/nt-admin-dock

    Option 4 - admin "Ops console": health status bar, KPI HUD, event stream, private ops notes,
    site activity meters and who is online. Data from output\nt_admin_dashboard.
}}
{{> theme_baz/nt-va-top }}
            <main class="nv-main nv-studio nv-ops" data-nv-uid="0">
                <section class="nv-opsbar" data-nv-health>
                    <span class="nv-kicker"><i class="nv-live"></i>{{#str}}nv_opsconsole, theme_baz{{/str}} · {{datelabel}}</span>
                    <div class="nv-opsbar-pills">{{#health}}<span data-state="{{state}}"><i></i>{{label}}</span>{{/health}}</div>
                    <b class="nv-opsscore"><span data-nv-health-pct>—</span> {{#str}}nv_healthy, theme_baz{{/str}}</b>
                </section>

                <section class="nv-stage nv-stage-adm">
                    <div class="nv-stage-l">
                        <h1 class="nv-hello">{{ntgreeting}}</h1>
                        <p class="nv-sub">{{{ntsubline}}}</p>
                    </div>
                    <div class="nv-hudkpis">
                        {{#ntkpis}}<div class="nv-hk" style="--c:{{color}}"><span>{{label}}</span><b>{{value}}</b><em class="{{#negative}}neg{{/negative}}" title="{{deltatip}}">{{delta}}</em>{{#hasspark}}<svg viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d="{{line}}" fill="none" stroke="{{color}}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>{{/hasspark}}</div>{{/ntkpis}}
                    </div>
                </section>

                <div class="nv-cols">
                    <div class="nv-col-main">
                        <section class="nv-panel nv-term">
                            <div class="nv-panel-h"><h2>{{#str}}nv_eventstream, theme_baz{{/str}}</h2><a href="{{ntactivityurl}}">{{#str}}nt_viewlogs, theme_baz{{/str}} →</a></div>
                            {{#nthasrecent}}<ol class="nv-stream">{{#ntrecent}}<li class="k-{{kind}}"><time>{{ago}}</time><span class="nv-kind">{{kind}}</span><span class="nv-msg"><b>{{title}}</b> <small>{{sub}}</small></span></li>{{/ntrecent}}</ol>{{/nthasrecent}}
                            {{^nthasrecent}}<p class="nv-empty">{{#str}}nt_norecent, theme_baz{{/str}}</p>{{/nthasrecent}}
                        </section>

                        <section class="nv-panel nv-opsnotes" data-nv-notes data-nv-key="nv-opsnotes">
                            <div class="nv-panel-h"><h2>{{#str}}nv_opsnotes, theme_baz{{/str}}</h2><span class="nv-saved" data-nv-saved hidden>{{#str}}nv_saved, theme_baz{{/str}}</span></div>
                            <textarea rows="7" placeholder="{{#str}}nv_opsnotes_ph, theme_baz{{/str}}" aria-label="{{#str}}nv_opsnotes, theme_baz{{/str}}"></textarea>
                            <small class="nv-private">{{#str}}nv_private, theme_baz{{/str}}</small>
                        </section>
                    </div>

                    <aside class="nv-col-side">
                        <section class="nv-panel">
                            <div class="nv-panel-h"><h2>{{#str}}nt_siteactivitytoday, theme_baz{{/str}}</h2><b class="nv-tag">{{ntacttotal}}{{#nthasactdelta}} · {{ntactdelta}}{{/nthasactdelta}}</b></div>
                            <ul class="nv-meters">{{#ntactparts}}<li style="--c:{{color}}"><span>{{label}}</span><b>{{n}}</b><i style="--n:{{n}}"></i></li>{{/ntactparts}}</ul>
                        </section>

                        <section class="nv-panel">
                            <div class="nv-panel-h"><h2>{{#str}}nv_presence, theme_baz{{/str}}</h2><a href="{{ntonlineurl}}">{{#str}}nt_viewall, theme_baz{{/str}} →</a></div>
                            {{#nthasonline}}<ul class="nv-presence">{{#ntonline}}<li><a href="{{url}}"><span class="nv-av" style="background:{{color}}">{{initials}}<i class="st-{{state}}"></i></span><span class="nv-txt"><b>{{name}}</b><small>{{status}}</small></span></a></li>{{/ntonline}}</ul>{{/nthasonline}}
                            {{^nthasonline}}<p class="nv-empty">{{#str}}nt_nobodyonline, theme_baz{{/str}}</p>{{/nthasonline}}
                        </section>

                    </aside>
                </div>

            </main>
{{> theme_baz/nt-v-bottom }}

{{!
    @template theme_baz/nt-student-dock

    Option 4 - Sapphire studio "mission control": live countdown to the next deadline, Ask JO
    command box, agenda timeline, 7-week study heatmap with a weekly goal ring, mood check-in,
    achievement wall, grade scoreboard, feed and podcasts. Menu = floating dock.
    Same data as theme_baz/nt-student-dashboard (output\nt_student_dashboard).
}}
{{> theme_baz/nt-v-top }}
            <main class="nv-main nv-studio" data-nv-uid="{{ntuserid}}">

                <section class="nv-stage">
                    <div class="nv-stage-l">
                        <span class="nv-kicker"><i class="nv-live"></i>{{datelabel}}</span>
                        <h1 class="nv-hello">{{ntgreeting}}</h1>
                        <p class="nv-sub">{{{ntsubline}}}</p>
                        {{#nthascoming}}
                        <div class="nv-mcwrap">
                            {{#ntcoming}}<a class="nv-mc" href="{{url}}"{{#external}} target="_blank" rel="noopener noreferrer"{{/external}}>
                                <span class="nv-mc-l">{{#str}}nv_nextup, theme_baz{{/str}}</span>
                                <span class="nv-mc-t">{{title}}</span>
                                <span class="nv-mc-cd" data-nv-countdown="big" data-ts="{{sort}}"></span>
                                <span class="nv-mc-m">{{meta}}</span>
                            </a>{{/ntcoming}}
                        </div>
                        {{/nthascoming}}
                        <div class="nv-actions">
                            {{#resumeitem}}<a class="nv-btn" href="{{url}}" title="{{name}}"><svg viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"/></svg>{{#str}}sd_resume, theme_baz{{/str}}</a>{{/resumeitem}}
                            {{^resumeitem}}{{#hasfocus}}<a class="nv-btn" href="{{focus.url}}"><svg viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"/></svg>{{#str}}sd_focusgo, theme_baz{{/str}}</a>{{/hasfocus}}{{/resumeitem}}
                            {{#showexamcta}}<a class="nv-btn nv-btn-soft" href="{{examctaurl}}">{{#str}}sd_exam_start, theme_baz{{/str}}</a>{{/showexamcta}}
                        </div>
                    </div>
                    <div class="nv-stage-r">
                        <div class="nv-orbit" style="--p:{{ringpct}}">
                            <div class="nv-orbit-in"><b>{{ringpct}}<small>%</small></b><span>{{#hassemester}}{{#str}}sd_semshort, theme_baz, {{semesternum}}{{/str}}{{/hassemester}}{{^hassemester}}{{#str}}sd_semprogress, theme_baz{{/str}}{{/hassemester}}</span></div>
                        </div>
                        <div class="nv-hud">
                            <div><b>{{coursecount}}</b><span>{{#str}}courses, core{{/str}}</span></div>
                            <div><b>{{ringcompleted}}</b><span>{{#str}}sd_completed, theme_baz{{/str}}</span></div>
                            <div><b>{{ntweektotal}}</b><span>{{#str}}nv_studiedweek, theme_baz{{/str}}</span></div>
                            {{#hasxp}}<div><b>{{xp.level}}</b><span>{{#str}}nt_level, theme_baz{{/str}} · {{xp.points}} {{#str}}sd_xp, theme_baz{{/str}}</span></div>{{/hasxp}}
                        </div>
                    </div>
                </section>

                {{#hasaskjo}}
                <form class="nv-cmd" data-nv-ask>
                    <span class="nv-cmd-ic"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg></span>
                    <input type="text" placeholder="{{#str}}nv_ask_ph, theme_baz{{/str}}" aria-label="{{#str}}sd_askjo, theme_baz{{/str}}">
                    <button type="submit">{{#str}}sd_askjo, theme_baz{{/str}} ↵</button>
                    <div class="nv-cmd-chips">
                        <button type="button" data-q="{{#str}}nv_q1, theme_baz{{/str}}">{{#str}}nv_q1, theme_baz{{/str}}</button>
                        <button type="button" data-q="{{#str}}nv_q2, theme_baz{{/str}}">{{#str}}nv_q2, theme_baz{{/str}}</button>
                        <button type="button" data-q="{{#str}}nv_q3, theme_baz{{/str}}">{{#str}}nv_q3, theme_baz{{/str}}</button>
                    </div>
                </form>
                {{/hasaskjo}}

                <div class="nv-cols">
                    <div class="nv-col-main">
                        <section class="nv-panel nv-now">
                            <div class="nv-panel-h"><h2>{{#str}}nv_nowlearning, theme_baz{{/str}}</h2>{{#hasfocus}}<span class="nv-tag">{{focus.statuslabel}}</span>{{/hasfocus}}</div>
                            {{#hasfocus}}
                            <a class="nv-now-name" href="{{focus.url}}">{{ntfocusname}}</a>
                            <div class="nv-neon"><i style="width:{{ntfocuspct}}%"></i><b>{{ntfocuspct}}%</b></div>
                            {{#ntfocusstats}}{{#ntfocushasnext}}{{#ntfocusnext}}<a class="nv-next" href="{{url}}"><span class="nv-next-ic"><svg viewBox="0 0 24 24">{{{icon}}}</svg></span><span><small>{{#str}}nt_f_upnext, theme_baz{{/str}} · {{kind}}</small><b>{{name}}</b></span><svg class="nv-go" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{{/ntfocusnext}}{{/ntfocushasnext}}{{/ntfocusstats}}
                            {{/hasfocus}}
                            {{^hasfocus}}<p class="nv-empty">{{#str}}nt_nofocus, theme_baz{{/str}}</p>{{/hasfocus}}
                        </section>

                        <section class="nv-panel nv-kanban" data-nv-kanban data-nv-help="{{#str}}nv_h_kanban, theme_baz{{/str}}" data-nv-tips="{{#str}}nv_tips_kanban, theme_baz{{/str}}">
                            <div class="nv-panel-h"><h2>{{#str}}nv_kanban, theme_baz{{/str}}</h2><span>{{#str}}nv_kanban_sub, theme_baz{{/str}}</span></div>
                            <form class="nvw-form"><input type="text" maxlength="60" placeholder="{{#str}}nv_k_ph, theme_baz{{/str}}" aria-label="{{#str}}nv_k_ph, theme_baz{{/str}}"><button type="submit" aria-label="{{#str}}add, core{{/str}}">+</button></form>
                            <div class="nvw-board">
                                <div data-col="todo"><h3>{{#str}}nv_k_todo, theme_baz{{/str}} <em data-n>0</em></h3><ul></ul></div>
                                <div data-col="doing"><h3>{{#str}}nv_k_doing, theme_baz{{/str}} <em data-n>0</em></h3><ul></ul></div>
                                <div data-col="done"><h3>{{#str}}nv_k_done, theme_baz{{/str}} <em data-n>0</em></h3><ul></ul></div>
                            </div>
                            <small class="nv-private">{{#str}}nv_private, theme_baz{{/str}}</small>
                        </section>

                        <section class="nv-panel nv-cards" data-nv-cards data-nv-help="{{#str}}nv_h_cards, theme_baz{{/str}}" data-nv-tips="{{#str}}nv_tips_cards, theme_baz{{/str}}" data-t-q="{{#str}}nv_c_q, theme_baz{{/str}}" data-t-a="{{#str}}nv_c_a, theme_baz{{/str}}">
                            <div class="nv-panel-h"><h2>{{#str}}nv_cards, theme_baz{{/str}}</h2><span data-count></span></div>
                            <button type="button" class="nvw-face" data-face aria-live="polite"><small data-face-side></small><span data-face-text></span></button>
                            <div class="nvw-cardctl"><button type="button" data-prev aria-label="{{#str}}nv_c_prev, theme_baz{{/str}}">‹</button><button type="button" data-del class="nvw-del">{{#str}}nv_c_del, theme_baz{{/str}}</button><button type="button" data-next aria-label="{{#str}}nv_c_next, theme_baz{{/str}}">›</button></div>
                            <p class="nvw-empty">{{#str}}nv_c_empty, theme_baz{{/str}}</p>
                            <form class="nvw-cardform"><input type="text" maxlength="140" data-q placeholder="{{#str}}nv_c_phq, theme_baz{{/str}}" aria-label="{{#str}}nv_c_phq, theme_baz{{/str}}"><input type="text" maxlength="240" data-a placeholder="{{#str}}nv_c_pha, theme_baz{{/str}}" aria-label="{{#str}}nv_c_pha, theme_baz{{/str}}"><button type="submit">{{#str}}nv_c_add, theme_baz{{/str}}</button></form>
                            <small class="nv-private">{{#str}}nv_private, theme_baz{{/str}}</small>
                        </section>

                        <section class="nv-panel nv-pulse">
                            <div class="nv-panel-h"><h2>{{#str}}nv_studypulse, theme_baz{{/str}}</h2><span>{{#str}}nv_7weeks, theme_baz{{/str}}</span></div>
                            <div class="nv-pulse-in">
                                <div class="nv-heatwrap">
                                    <div class="nv-heat">{{#ntheat}}<i class="l{{lvl}}{{#today}} today{{/today}}" title="{{label}} · {{value}}"></i>{{/ntheat}}</div>
                                    <div class="nv-heat-key"><span>{{#str}}nv_less, theme_baz{{/str}}</span><i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i><span>{{#str}}nv_more, theme_baz{{/str}}</span></div>
                                </div>
                                <div class="nv-goal" data-nv-goal data-secs="{{ntweeksecs}}">
                                    <div class="nv-goal-ring"><b data-nv-goal-pct>0%</b><small>{{#str}}nv_weeklygoal, theme_baz{{/str}}</small></div>
                                    <div class="nv-goal-ctl"><button type="button" data-step="-1" aria-label="−1h">−</button><span><b data-nv-goal-h>10h</b> {{#str}}nv_perweek, theme_baz{{/str}}</span><button type="button" data-step="1" aria-label="+1h">+</button></div>
                                    <small class="nv-goal-now">{{ntweektotal}} {{#str}}nv_sofar, theme_baz{{/str}}</small>
                                </div>
                            </div>
                        </section>

                    </div>

                    <aside class="nv-col-side">
                        <section class="nv-panel nv-mood" data-nv-mood data-nv-help="{{#str}}nv_h_mood, theme_baz{{/str}}" data-nv-tips="{{#str}}nv_tips_mood, theme_baz{{/str}}">
                            <div class="nv-panel-h"><h2>{{#str}}nv_mood, theme_baz{{/str}}</h2><span data-nv-mood-when></span></div>
                            <p class="nv-mood-q">{{#str}}nv_mood_q, theme_baz{{/str}}</p>
                            <div class="nv-mood-pick" role="radiogroup" aria-label="{{#str}}nv_mood, theme_baz{{/str}}">
                                <button type="button" data-m="1" aria-label="{{#str}}nv_mood_l1, theme_baz{{/str}}">😫</button><button type="button" data-m="2" aria-label="{{#str}}nv_mood_l2, theme_baz{{/str}}">😕</button><button type="button" data-m="3" aria-label="{{#str}}nv_mood_l3, theme_baz{{/str}}">😐</button><button type="button" data-m="4" aria-label="{{#str}}nv_mood_l4, theme_baz{{/str}}">🙂</button><button type="button" data-m="5" aria-label="{{#str}}nv_mood_l5, theme_baz{{/str}}">🤩</button>
                            </div>
                            <p class="nv-mood-tip" data-tip="1" hidden>{{#str}}nv_mood_t1, theme_baz{{/str}}</p><p class="nv-mood-tip" data-tip="2" hidden>{{#str}}nv_mood_t2, theme_baz{{/str}}</p><p class="nv-mood-tip" data-tip="3" hidden>{{#str}}nv_mood_t3, theme_baz{{/str}}</p><p class="nv-mood-tip" data-tip="4" hidden>{{#str}}nv_mood_t4, theme_baz{{/str}}</p><p class="nv-mood-tip" data-tip="5" hidden>{{#str}}nv_mood_t5, theme_baz{{/str}}</p>
                            <div class="nv-mood-week" data-nv-mood-week></div>
                            <small class="nv-private">{{#str}}nv_private, theme_baz{{/str}}</small>
                        </section>

                        <section class="nv-panel nv-wall" data-nv-badges data-streak="{{streak}}" data-done="{{ringcompleted}}" data-level="{{xp.level}}" data-courses="{{coursecount}}" data-progress="{{ringpct}}" data-secs="{{ntweeksecs}}">
                            <div class="nv-panel-h"><h2>{{#str}}nv_badges, theme_baz{{/str}}</h2><span data-nv-badge-count></span></div>
                            <div class="nv-badges">
                                <span data-metric="streak" data-need="3"><i>🔥</i>{{#str}}nv_b_streak, theme_baz{{/str}}</span>
                                <span data-metric="done" data-need="1"><i>🏁</i>{{#str}}nv_b_finisher, theme_baz{{/str}}</span>
                                <span data-metric="best" data-need="90"><i>⭐</i>{{#str}}nv_b_topscore, theme_baz{{/str}}</span>
                                <span data-metric="hours" data-need="5"><i>⏱</i>{{#str}}nv_b_focused, theme_baz{{/str}}</span>
                                <span data-metric="progress" data-need="50"><i>🧭</i>{{#str}}nv_b_halfway, theme_baz{{/str}}</span>
                                <span data-metric="level" data-need="3"><i>🚀</i>{{#str}}nv_b_levelup, theme_baz{{/str}}</span>
                            </div>
                        </section>

                        <section class="nv-panel" data-nv-grades>
                            <div class="nv-panel-h"><h2>{{#str}}nv_scoreboard, theme_baz{{/str}}</h2><a href="{{{ config.wwwroot }}}/grade/report/overview/index.php">{{#str}}nt_viewall, theme_baz{{/str}} →</a></div>
                            {{#nthasgrades}}
                            <ol class="nv-score">{{#ntgrades}}<li><a href="{{url}}" data-nv-pct="{{pct}}"><span class="nv-letter" data-nv-grade="{{pct}}"></span><span class="nv-txt"><b>{{name}}</b><small>{{course}} · {{date}}</small></span><em>{{score}}</em></a></li>{{/ntgrades}}</ol>
                            <div class="nv-score-avg">{{#str}}nv_average, theme_baz{{/str}} <b data-nv-avg>—</b> · <b data-nv-avg="letter">—</b></div>
                            {{/nthasgrades}}
                            {{^nthasgrades}}<p class="nv-empty">{{#str}}nt_nogrades, theme_baz{{/str}}</p>{{/nthasgrades}}
                        </section>

                        {{#hasfee}}<section class="nv-panel nv-fee"><h2>{{fee.title}}</h2><p>{{fee.desc}}</p><a class="nv-btn" href="{{fee.payurl}}" target="_blank" rel="noopener">{{fee.button}} →</a></section>{{/hasfee}}

                        
                    </aside>
                </div>

                {{#haspodcasts}}
                <section class="nv-panel">
                    <div class="nv-panel-h"><h2>{{#str}}sd_podcasts, theme_baz{{/str}}</h2></div>
                    <div class="nv-playlist">{{#podcasts}}<a href="{{url}}" target="_blank" rel="noopener"><span class="nv-r-ic nv-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span><span class="nv-txt"><b>{{title}}</b><small>{{source}}</small></span></a>{{/podcasts}}</div>
                </section>
                {{/haspodcasts}}

                <p class="nv-footnote">{{brandfootnote}}</p>
            </main>
{{> theme_baz/nt-v-bottom }}

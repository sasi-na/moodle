<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/zoomonline/db" VERSION="2025021100" COMMENT="XMLDB file for Moodle blocks/zoomonline"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="block_zoomonline_links" COMMENT="Table for saving Zoom links">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="zoom_meeting_id" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="lecturer_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="References Moodle user ID"/>
                <FIELD NAME="course_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="References Moodle course ID"/>
                <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="References Moodle group ID"/>
                <FIELD NAME="visible" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = hidden, 1 = visible"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time of last modification"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="zoom_meeting_idx" UNIQUE="true" FIELDS="zoom_meeting_id"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="block_zoomonline_att_check" COMMENT="Table for marking attendance as processed">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="zoom_meeting_id" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="start_date" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time of last modification"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="block_zoomonline_token" COMMENT="Table for saving Zoom OAuth tokens">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="access_token" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="current" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Date the token was created"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>

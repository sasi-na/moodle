<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/fileshare/db" VERSION="2026081400" COMMENT="Expiring, file-scoped share links for question response attachments"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <TABLES>
    <TABLE NAME="local_fileshare" COMMENT="One row per share link. The token itself is never stored here - only the id of its user_private_key row, so revoking means deleting that key.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pathnamehash" TYPE="char" LENGTH="40" NOTNULL="true" COMMENT="The shared file. Path-derived, so contenthash is checked too."/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="40" NOTNULL="true" COMMENT="Refuse to serve if the bytes behind the path have changed."/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Module context of the quiz, used for events and reporting."/>
        <FIELD NAME="qubaid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="slot" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="filesize" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="studentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Whose submission this is."/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="keyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="user_private_key.id; 0 once revoked."/>
        <FIELD NAME="validuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="iprestriction" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="maxdownloads" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="0 = unlimited."/>
        <FIELD NAME="downloads" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lastaccess" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="revoked" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="recipient" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Free text: who the link was given to."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="keyid" UNIQUE="false" FIELDS="keyid"/>
        <INDEX NAME="createdby" UNIQUE="false" FIELDS="createdby"/>
        <INDEX NAME="studentid" UNIQUE="false" FIELDS="studentid"/>
        <INDEX NAME="validuntil" UNIQUE="false" FIELDS="validuntil"/>
        <INDEX NAME="pathnamehash" UNIQUE="false" FIELDS="pathnamehash"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>

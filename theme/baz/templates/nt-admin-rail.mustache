{{!
    @template theme_baz/nt-admin-rail

    Option 3 - admin "Control center": light bento with a health score ring, KPI tiles,
    quick find (settings / courses), a private admin checklist and engagement.
    Data from output\nt_admin_dashboard.
}}
{{> theme_baz/nt-va-top }}
            <main class="nv-main nv-bento nv-adm" data-nv-uid="0">
                <section class="nv-tile nv-t-ahero" data-nv-ring>
                    <div>
                        <span class="nv-kicker">{{datelabel}} · {{#str}}nv_controlcenter, theme_baz{{/str}}</span>
                        <h1 class="nv-hello">{{ntgreeting}}</h1>
                        <p class="nv-sub">{{{ntsubline}}}</p>
                        <div class="nv-actions"><a class="nv-btn" href="{{ntsiteadminurl}}">{{#str}}administrationsite, core{{/str}} →</a><a class="nv-btn nv-btn-soft" href="{{nttasksurl}}">{{#str}}nv_a_tasks, theme_baz{{/str}}</a></div>
                    </div>
                    <div class="nv-hring"><b data-nv-health-pct>—</b><small>{{#str}}nv_healthscore, theme_baz{{/str}}</small></div>
                    <span hidden data-nv-health>{{#health}}<i data-state="{{state}}"></i>{{/health}}</span>
                </section>

                {{#ntkpis}}
                <section class="nv-tile nv-t-kpi">
                    <span class="nv-label">{{label}}</span>
                    <b class="nv-bignum">{{value}}</b>
                    <span class="nv-delta{{#negative}} neg{{/negative}}" title="{{deltatip}}">{{delta}}</span>
                    {{#hasspark}}<svg class="nv-spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d="{{area}}" fill="{{color}}" fill-opacity=".16"/><path d="{{line}}" fill="none" stroke="{{color}}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>{{/hasspark}}
                </section>
                {{/ntkpis}}

                <section class="nv-tile nv-t-eng" data-nt-tabs>
                    <div class="nv-tile-h"><h2>{{#str}}nt_engagement, theme_baz{{/str}}</h2><div class="nt-seg-tabs" role="tablist">{{#ntcharts}}<button type="button" class="{{#active}}on{{/active}}" data-nt-tab="{{key}}" role="tab">{{#str}}nt_ndays, theme_baz, {{key}}{{/str}}</button>{{/ntcharts}}</div></div>
                    {{#ntcharts}}<div data-nt-pane="{{key}}" {{^active}}hidden{{/active}}><div class="nt-chart"><svg viewBox="0 0 600 220" preserveAspectRatio="none"><path d="{{area}}" class="nt-area"/><path d="{{line}}" class="nt-line" vector-effect="non-scaling-stroke"/></svg><div class="nt-xl">{{#labels}}<span style="left:{{left}}%">{{text}}</span>{{/labels}}</div></div></div>{{/ntcharts}}
                    <div class="nv-engfig"><div><b>{{eng_activetoday}}</b><span>{{#str}}nt_kpi_activetoday, theme_baz{{/str}}</span></div><div><b>{{eng_wau}}</b><span>{{#str}}nt_weeklyactive, theme_baz{{/str}}</span></div><div><b>{{eng_mau}}</b><span>{{#str}}nt_monthlyactive, theme_baz{{/str}}</span></div><div><b>{{eng_stickiness}}</b><span>{{#str}}nt_stickiness, theme_baz{{/str}}</span></div></div>
                </section>

                <section class="nv-tile nv-t-find">
                    <div class="nv-tile-h"><h2><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>{{#str}}nv_quickfind, theme_baz{{/str}}</h2></div>
                    <form class="nv-find" action="{{{ config.wwwroot }}}/admin/search.php" method="get"><label>{{#str}}nv_qf_settings, theme_baz{{/str}}</label><div><input type="search" name="query" maxlength="100" placeholder="{{#str}}nv_qf_settings_ph, theme_baz{{/str}}" aria-label="{{#str}}nv_qf_settings, theme_baz{{/str}}"><button type="submit">{{#str}}nv_go, theme_baz{{/str}}</button></div></form>
                    <form class="nv-find" action="{{{ config.wwwroot }}}/course/search.php" method="get"><label>{{#str}}nv_qf_courses, theme_baz{{/str}}</label><div><input type="search" name="search" maxlength="100" placeholder="{{#str}}nv_qf_courses_ph, theme_baz{{/str}}" aria-label="{{#str}}nv_qf_courses, theme_baz{{/str}}"><button type="submit">{{#str}}nv_go, theme_baz{{/str}}</button></div></form>
                </section>

                <section class="nv-tile nv-t-todo nv-t-achk" data-nv-todo data-nv-key="nv-admtodo">
                    <div class="nv-tile-h"><h2><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>{{#str}}nv_achecklist, theme_baz{{/str}}</h2><span data-nv-todo-count></span></div>
                    <form class="nv-todo-add"><input type="text" maxlength="140" placeholder="{{#str}}nv_achecklist_ph, theme_baz{{/str}}" aria-label="{{#str}}nv_achecklist_ph, theme_baz{{/str}}"><button type="submit" aria-label="{{#str}}add, core{{/str}}">+</button></form>
                    <ul class="nv-todo-list"></ul>
                    <p class="nv-todo-empty">{{#str}}nv_achecklist_empty, theme_baz{{/str}}</p>
                </section>

            </main>
{{> theme_baz/nt-v-bottom }}

{{!
    @template theme_baz/homenav

    The persistent left-menu block, shared by the admin pages shell and by both
    /my/ dashboards. Each of those used to carry its own copy, so the menu changed
    shape when the viewer moved between them.

    Context supplied by theme_baz\local\shell::home_nav().

    Example context (json):
    {
        "homenav": [
            {"label": "Dashboard", "url": "/my/", "icon_dashboard": true, "active": true}
        ]
    }
}}
{{#homenav}}
<a href="{{url}}"{{#active}} class="on" aria-current="page"{{/active}}>
    {{#icon_dashboard}}<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>{{/icon_dashboard}}
    {{#icon_courses}}<svg viewBox="0 0 24 24"><path d="M4 5h16M4 5v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V5M4 5l2-2h12l2 2"/><path d="M9 11h6M9 15h4"/></svg>{{/icon_courses}}
    {{#icon_calendar}}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>{{/icon_calendar}}
    {{#icon_siteadmin}}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>{{/icon_siteadmin}}
    <span>{{label}}</span></a>
{{/homenav}}

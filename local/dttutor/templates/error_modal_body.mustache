{{!
    @template local_dttutor/error_modal_body

    Error modal body template for Tutor-IA

    Context variables required for this template:
    * message - Error message to display

    Example context (json):
    {
        "message": "The AI Tutor chat is currently unavailable."
    }
}}
<div class="tutor-ia-error-modal">
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle"></i>
        <span>{{message}}</span>
    </div>
</div>

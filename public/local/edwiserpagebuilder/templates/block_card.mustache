{{#blocks}}
<div class="card-wrapper {{blockgroup}} {{additionalclass}} {{section}} {{blocktype}}" data-parentblock="{{name}}" data-block="{{name}}{{#section}}{{section}}{{/section}}" data-blockid="{{id}}">
    <div class="card-item w-100 h-100">
        {{#addableblock}}
        <a  
            {{^locked}}href="{{url}}&amp;bui_addblock={{name}}{{#section}}&amp;section={{section}}{{/section}}"{{/locked}}
            {{^isleftsidebarblock}}{{#locked}}href="https://edwiser.org/page-builder-for-moodle/" target="_blank"{{/locked}}{{/isleftsidebarblock}}
            class="blockurl" 
        ></a>
        {{/addableblock}}
        
        {{^addableblock}}
        <a 
            {{^locked}}href="#" data-block-region="{{blockregion}}" data-block="{{#section}}{{section}}{{/section}}" block-pagetypepattern = '{{blockpagetype}}'{{/locked}}
            {{#locked}}href="https://edwiser.org/page-builder-for-moodle/" target="_blank"{{/locked}}
            class="blockurl {{^locked}}{{blocktype}}-btn{{/locked}}" 
        ></a>
        {{/addableblock}}
        
        <div class="card">
            {{#addableblock}}
            <a {{^locked}}href="{{url}}&amp;bui_addblock={{name}}{{#section}}&amp;section={{section}}{{/section}}"{{/locked}} class="list-group-item p-0 ">
                <div class="card-body d-flex justify-content-center align-items-center">
                    <div class="block-cover " style="background: url('{{thumbnail}}'); !important">

                    </div>
                </div>
                
                {{#locked}}{{^isleftsidebarblock}}
                    <div class="locked-block-overlay">
                        <button class="upgrade-to-pro-btn hidden-in-list-view" title="{{#str}}upgrade_to_pro, local_edwiserpagebuilder{{/str}}">
                            <image src="{{wwwroot}}/local/edwiserpagebuilder/pix/lock-light-icon.svg" width="16" height="16" alt="">
                            <span>{{#str}}upgrade_to_pro, local_edwiserpagebuilder{{/str}}</span>
                        </button>
                    </div>
                {{/isleftsidebarblock}}{{/locked}}
            </a>
            {{/addableblock}}
            {{^addableblock}}
            <a href="#"  class="list-group-item p-0 " >
                <div class="card-body d-flex justify-content-center align-items-center">
                    <img src="{{thumbnail}}">
                </div>
                
                 {{#locked}}{{^isleftsidebarblock}}

                    <div class="locked-block-overlay">
                        <button class="upgrade-to-pro-btn hidden-in-list-view" title="{{#str}}upgrade_to_pro, local_edwiserpagebuilder{{/str}}">
                            <image src="{{wwwroot}}/local/edwiserpagebuilder/pix/lock-light-icon.svg" width="16" height="16" alt="">
                            <span>{{#str}}upgrade_to_pro, local_edwiserpagebuilder{{/str}}</span>
                        </button>
                    </div>

                {{/isleftsidebarblock}}{{/locked}}
            </a>
            {{/addableblock}}
            <div class="card-footer d-flex justify-content-between align-items-center">
                <div class="h-semibold-6">
                    {{#addableblock}}
                    <a href="{{url}}&amp;bui_addblock={{name}}{{#section}}&amp;section={{section}}{{/section}}" class="text-decoration-none footer-add-link">
                        <span class="edw-icon {{#importicon}}edw-icon-Download{{/importicon}} {{^importicon}}edw-icon-Add-block{{/importicon}} d-none" {{#locked}}{{#isleftsidebarblock}} style="opacity: 0.4;"{{/isleftsidebarblock}}{{/locked}}></span>
                        <span {{#locked}}{{#isleftsidebarblock}} style="opacity: 0.4;"{{/isleftsidebarblock}}{{/locked}}>{{title}}</span>
                        {{#locked}}{{#isleftsidebarblock}} <image src="{{wwwroot}}/local/edwiserpagebuilder/pix/lock-fill-icon.svg" width="24" height="24" alt="locked"> {{/isleftsidebarblock}} {{/locked}}
                    </a>
                    {{/addableblock}}
                    {{^addableblock}}
                    <a href="#" class="text-decoration-none footer-add-link">
                        <span class="edw-icon {{#importicon}}edw-icon-Download{{/importicon}} {{^importicon}}edw-icon-Add-block{{/importicon}} d-none"></span>
                        <span>{{title}}</span>
                        {{#locked}}{{#isleftsidebarblock}} <image src="{{wwwroot}}/local/edwiserpagebuilder/pix/lock-fill-icon.svg" width="24" height="24" alt="locked"> {{/isleftsidebarblock}} {{/locked}}
                    </a>
                    {{/addableblock}}
                </div>
                <div class="action-icon-wrapper">
                
                    {{#locked}}{{^isleftsidebarblock}}
                    <button class="upgrade-to-pro-btn hidden-in-grid-view" title="{{#str}}upgrade_to_pro, local_edwiserpagebuilder{{/str}}">
                        <image src="{{wwwroot}}/local/edwiserpagebuilder/pix/lock-light-icon.svg" width="16" height="16" alt="" >
                        <span>{{#str}}upgrade_to_pro, local_edwiserpagebuilder{{/str}}</span>
                    </button>
                    {{/isleftsidebarblock}}{{/locked}}
                    
                    {{! info-wrapper added for showing block information }}
                    {{#blockinfo}}
                        <div class="info-wrapper">
                            <i class="edw-icon edw-icon-Info info-about fa-solid fa-circle-info" title=""></i>
                            <div class="info-about-box-wrapper">
                                <div class="info-about-box">
                                    <p class="m-0">{{{blockinfo}}} </p>
                                </div>
                            </div>
                        </div>
                    {{/blockinfo}}

                    {{^visible}}
                        <i class="edw-icon edw-icon-Info info-deprecated fa-solid fa-circle-info" title="{{#str}}blockdeprecated, local_edwiserpagebuilder{{/str}}"></i>
                    {{/visible}}
                   
                    {{#updateavailable}}
                    <a href="#" class=" update-content text-decoration-none" data-blockname="{{section}}" title="{{#str}}updateblockcontent, local_edwiserpagebuilder{{/str}}">
                        <span class="edw-icon edw-icon-Refresh fa-solid fa-rotate-right d-flex"></span>
                    </a>
                    {{/updateavailable}}

                    {{^visible}}
                    <a href="#" class="delete-content text-decoration-none" data-blockname="{{section}}" title="{{#str}}deleteblockcontent, local_edwiserpagebuilder{{/str}}" data-blockid="{{id}}">
                        <span class="edw-icon edw-icon-Delete-Course fa-solid fa-trash-can d-flex"></span>
                    </a>
                    {{/visible}}
                </div>
            </div>

        </div>
        {{#section}}<div class="ribbon d-none">Edwiser</div>{{/section}}
    </div>
</div>
{{/blocks}}

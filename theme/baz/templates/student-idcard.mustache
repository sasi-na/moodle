{{!
    @template theme_baz/student-idcard

    Bespoke Student e-ID Card portal for student-only (eligible batch) users.
    Reuses the shared navy/gold app shell. Action processing (download / update /
    submit) is handled by local/studentid/index.php before this layout renders.
}}
{{> theme_baz/head }}

<body {{{ bodyattributes }}}>
    {{> core/local/toast/wrapper}}

    <div id="page-wrapper" class="d-print-block">
        {{{ output.standard_top_of_body_html }}}

        <div id="sid-root" class="sid-app">

            <div class="sid-backdrop" id="sid-backdrop"></div>
            <aside class="sid-side" id="sid-side">
                <a class="sid-brand" href="{{dashboardurl}}">
                    {{! The sidebar is always navy, unlike the classic topbar that customlogo
                        also feeds, so prefer the sidebar logo where a site supplies one. }}
                    {{#customsidebarlogo}}<img src="{{customsidebarlogo}}" alt="{{sitename}}">{{/customsidebarlogo}}
                    {{^customsidebarlogo}}
                        {{#customlogo}}<img src="{{customlogo}}" alt="{{sitename}}">{{/customlogo}}
                        {{^customlogo}}<span class="sid-brand-txt">{{{ sitename }}}</span>{{/customlogo}}
                    {{/customsidebarlogo}}
                </a>
                <nav class="sid-nav">
                    <a href="{{dashboardurl}}"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg> {{#str}}sd_nav_dashboard, theme_baz{{/str}}</a>
                    <a href="{{coursesurl}}"><svg viewBox="0 0 24 24"><path d="M4 5h16M4 5v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V5M9 11h6M9 15h4"/></svg> {{#str}}sd_nav_courses, theme_baz{{/str}}</a>
                    <a href="{{calendarurl}}"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg> {{#str}}sd_nav_calendar, theme_baz{{/str}}</a>
                    <a href="{{mygradesurl}}"><svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/></svg> {{#str}}sd_nav_grades, theme_baz{{/str}}</a>
                    {{#hasinterestzone}}
                    <a href="{{interestzoneurl}}"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.25"/><circle cx="12" cy="9" r="1" fill="currentColor" stroke="none"/><path d="M12 13V15"/></svg> {{interestzonelabel}}</a>
                    {{/hasinterestzone}}
                    <div class="sid-navlbl">{{#str}}sd_nav_resources, theme_baz{{/str}}</div>
                    <a href="#" class="on"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="11" r="2"/><path d="M13 10h5M13.5 14h3M5 16c.4-1.4 1.5-2 3-2s2.6.6 3 2"/></svg> {{#str}}pluginname, local_studentid{{/str}}</a>
                    <a href="{{filesurl}}"><svg viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h6l2 2h6a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg> {{#str}}sd_nav_files, theme_baz{{/str}}</a>
                </nav>
            {{> theme_baz/sidebar-support }}
            </aside>

            <div class="sid-main-col">
                <header class="sid-topbar">
                    <div class="sid-topbar-inner">
                        <div class="sid-tb-left">
                            <button type="button" class="sid-burger" id="sid-burger" aria-label="{{#str}}sd_menu, theme_baz{{/str}}"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
                            <nav class="sid-crumb"><a href="{{dashboardurl}}">{{#str}}sd_nav_resources, theme_baz{{/str}}</a><span class="sep">/</span><span class="cur">{{#str}}pluginname, local_studentid{{/str}}</span></nav>
                        </div>
                        <div class="sid-tb-right">
                            {{#hasaskjo}}<button type="button" class="sid-askjo" id="sid-askjo-btn"><svg viewBox="0 0 24 24" fill="var(--bz-accent)"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8z"/></svg> {{#str}}sd_askjo, theme_baz{{/str}}</button>{{/hasaskjo}}
                            <button type="button" class="sid-iconbtn" id="sid-themebtn" title="{{#str}}sd_toggletheme, theme_baz{{/str}}"><svg id="sid-themeicon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
                            <div class="sid-navbar-plugin">{{{ output.navbar_plugin_output }}}</div>
                            <div class="sid-usermenu">{{{ output.user_menu }}}</div>
                        </div>
                    </div>
                </header>

                <main class="sid-content">
                    <div class="sid-phead">
                        <div>
                            <div class="sid-eyebrow">{{#str}}sid_eyebrow, theme_baz{{/str}}</div>
                            <h1>{{#str}}pluginname, local_studentid{{/str}}</h1>
                            <p>{{#str}}sid_sub, theme_baz, {{brandname}}{{/str}}</p>
                        </div>
                        {{#isready}}<span class="sid-pill ok"><span></span>{{#str}}sid_ready, theme_baz{{/str}}</span>{{/isready}}
                        {{^isready}}{{#statuslabel}}<span class="sid-pill">{{statuslabel}}</span>{{/statuslabel}}{{/isready}}
                    </div>

                    {{#isrejected}}
                    <div class="sid-alert">
                        <span class="sid-alert-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></span>
                        <div><b>{{#str}}sid_rejected_title, theme_baz{{/str}}</b>{{#rejectcomment}}<p>{{rejectcomment}}</p>{{/rejectcomment}}</div>
                    </div>
                    {{/isrejected}}

                    <div class="sid-grid">
                        <div class="sid-col">
                            {{#isready}}
                            <div class="sid-cardwrap">
                                <div class="idc">
                                    <div class="idc-sheen"></div>
                                    <div class="idc-top"><div class="idc-brand"><span class="idc-logo">JAIN</span><span class="idc-subl">ONLINE</span></div><div class="idc-kind">{{#str}}sid_identity, theme_baz{{/str}}</div></div>
                                    <div class="idc-body">
                                        <div class="idc-photo">{{initials}}</div>
                                        <div class="idc-info">
                                            <div class="idc-name">{{name}}</div>
                                            <div class="idc-prog">{{program}}</div>
                                            <div class="idc-pair"><div><label>{{#str}}sid_usn, theme_baz{{/str}}</label><b>{{usn}}</b></div><div><label>{{#str}}sid_batch, theme_baz{{/str}}</label><b>{{batch}}</b></div></div>
                                        </div>
                                    </div>
                                    <div class="idc-foot">
                                        <div class="idc-no"><label>{{#str}}sid_cardno, theme_baz{{/str}}</label><b>{{cardno}}</b></div>
                                        <div class="idc-qr">{{#qr}}<i class="{{on}}"></i>{{/qr}}</div>
                                    </div>
                                </div>
                            </div>

                            <div class="sid-panel">
                                <h3><span class="sid-dot"></span>{{#str}}sid_carddetails, theme_baz{{/str}}</h3>
                                <div class="sid-dl">
                                    <div class="sid-di"><label>{{#str}}sid_cardno, theme_baz{{/str}}</label><b>{{cardno}}</b></div>
                                    <div class="sid-di"><label>{{#str}}sid_usn, theme_baz{{/str}}</label><b>{{usn}}</b></div>
                                    {{#hasissued}}<div class="sid-di"><label>{{#str}}sid_issued, theme_baz{{/str}}</label><b>{{issued}}</b></div>{{/hasissued}}
                                    <div class="sid-di"><label>{{#str}}sid_batch, theme_baz{{/str}}</label><b>{{batch}}</b></div>
                                    <div class="sid-di sid-di-wide"><label>{{#str}}sid_program, theme_baz{{/str}}</label><b class="sans">{{program}}</b></div>
                                </div>
                            </div>
                            {{/isready}}

                            {{#isnone}}
                            <div class="sid-empty">
                                <span class="sid-empty-ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="11" r="2"/><path d="M13 10h5M13.5 14h3M5 16c.4-1.4 1.5-2 3-2s2.6.6 3 2"/></svg></span>
                                <h2>{{#str}}sid_none_title, theme_baz{{/str}}</h2>
                                <p>{{#str}}sid_none_sub, theme_baz, {{brandname}}{{/str}}</p>
                                <a class="sid-btn sid-btn-gold" href="{{requesturl}}"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> {{#str}}sid_request, theme_baz{{/str}}</a>
                            </div>
                            {{/isnone}}

                            {{#isdraft}}
                            <div class="sid-empty">
                                <span class="sid-empty-ic"><svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span>
                                <h2>{{#str}}sid_draft_title, theme_baz{{/str}}</h2>
                                <p>{{#str}}sid_draft_sub, theme_baz{{/str}}</p>
                                <div class="sid-empty-actions">
                                    <a class="sid-btn sid-btn-ghost" href="{{editurl}}"><svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg> {{#str}}sid_continue, theme_baz{{/str}}</a>
                                    {{#cansubmit}}
                                    <form method="post" action="{{updateurl}}" class="sid-inlineform">
                                        <input type="hidden" name="action" value="submit">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <button type="submit" class="sid-btn sid-btn-gold"><svg viewBox="0 0 24 24"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg> {{#str}}sid_submit, theme_baz{{/str}}</button>
                                    </form>
                                    {{/cansubmit}}
                                </div>
                            </div>
                            {{/isdraft}}

                            {{#isreview}}
                            <div class="sid-empty">
                                <span class="sid-empty-ic"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
                                <h2>{{#str}}sid_review_title, theme_baz{{/str}}</h2>
                                <p>{{#str}}sid_review_sub, theme_baz{{/str}}</p>
                            </div>
                            {{/isreview}}

                            {{#isrejected}}
                            <div class="sid-empty">
                                <span class="sid-empty-ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="11" r="2"/></svg></span>
                                <h2>{{#str}}sid_reapply_title, theme_baz{{/str}}</h2>
                                <p>{{#str}}sid_reapply_sub, theme_baz{{/str}}</p>
                                <a class="sid-btn sid-btn-gold" href="{{requesturl}}"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> {{#str}}sid_request, theme_baz{{/str}}</a>
                            </div>
                            {{/isrejected}}

                            {{#hashistory}}
                            <div class="sid-history">
                                <h2 class="sid-sech">{{#str}}sid_history, theme_baz{{/str}}</h2>
                                {{#history}}
                                <div class="sid-hrow">
                                    <span class="sid-hic {{#isapproved}}ok{{/isapproved}}{{#isrejected}}no{{/isrejected}}">{{#isapproved}}<svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>{{/isapproved}}{{^isapproved}}<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="3"/></svg>{{/isapproved}}</span>
                                    <span class="sid-hmain"><span class="sid-hn">{{#str}}sid_request_label, theme_baz{{/str}}</span><span class="sid-hm">{{#str}}sid_submitted_on, theme_baz, {{submitted}}{{/str}} &middot; {{#str}}sid_created_on, theme_baz, {{created}}{{/str}}</span>{{#hascomment}}<span class="sid-hc">{{comment}}</span>{{/hascomment}}</span>
                                    <span class="sid-htag {{#isapproved}}ok{{/isapproved}}{{#isrejected}}no{{/isrejected}}">{{statuslabel}}</span>
                                </div>
                                {{/history}}
                            </div>
                            {{/hashistory}}
                        </div>

                        <div class="sid-rail">
                            {{#showstepper}}
                            <div class="sid-panel">
                                <h3><span class="sid-dot"></span>{{#str}}sid_appstatus, theme_baz{{/str}}</h3>
                                <div class="sid-steplist">
                                    {{#steps}}
                                    <div class="sid-stp {{#done}}done{{/done}}{{#active}}active{{/active}}{{#todo}}todo{{/todo}}">
                                        <span class="sid-stp-dot">{{#done}}<svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>{{/done}}{{^done}}<span class="sid-stp-n">{{idx}}</span>{{/done}}</span>
                                        <span class="sid-stp-lbl">{{label}}</span>
                                    </div>
                                    {{^last}}<span class="sid-stp-bar"></span>{{/last}}
                                    {{/steps}}
                                </div>
                            </div>
                            {{/showstepper}}

                            {{#isready}}
                            <div class="sid-panel">
                                <a class="sid-btn sid-btn-gold" href="{{downloadurl}}"><svg viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 4 5-4M4 21h16"/></svg> {{#str}}sid_download, theme_baz{{/str}}</a>
                                {{#canupdate}}
                                <form method="post" action="{{updateurl}}" class="sid-inlineform sid-block">
                                    <input type="hidden" name="action" value="update">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <button type="submit" class="sid-btn sid-btn-ghost"><svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg> {{#str}}sid_update, theme_baz{{/str}}</button>
                                </form>
                                {{/canupdate}}
                            </div>
                            <div class="sid-panel">
                                <h3><span class="sid-dot"></span>{{#str}}sid_downloads, theme_baz{{/str}}</h3>
                                <div class="sid-stat"><span class="sid-sic"><svg viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 4 5-4M4 21h16"/></svg></span><div><div class="sid-sn">{{#str}}sid_timesdl, theme_baz{{/str}}</div><div class="sid-sm">{{#str}}sid_sinceissue, theme_baz{{/str}}</div></div><b class="sid-big">{{downloads}}</b></div>
                                <div class="sid-stat"><span class="sid-sic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg></span><div><div class="sid-sn">{{#str}}sid_lastdl, theme_baz{{/str}}</div><div class="sid-sm">{{lastdownloaded}}</div></div></div>
                            </div>
                            {{/isready}}
                        </div>
                    </div>

                    <div id="region-main-box" class="sid-region-main"><section id="region-main" aria-label="{{#str}}content{{/str}}">{{{ output.main_content }}}</section></div>
                </main>
            </div>

            {{#hassupport}}
            <div class="sid-help">
                <div class="sid-help-panel" id="sid-help-panel" hidden>
                    <div class="sid-help-head"><span class="sid-help-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M5 5l3.6 3.6M15.4 15.4 19 19M19 5l-3.6 3.6M8.6 15.4 5 19"/></svg></span><div class="sid-help-t"><b>{{#str}}sd_help, theme_baz{{/str}}</b><small>{{#str}}sd_help_sub, theme_baz{{/str}}</small></div><button type="button" class="sid-help-close" id="sid-help-close" aria-label="Close">&times;</button></div>
                    <div class="sd-blockcontent sd-support">{{{ support_html }}}</div>
                </div>
                <button type="button" class="sid-help-fab" id="sid-help-fab" aria-expanded="false">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M5 5l3.6 3.6M15.4 15.4 19 19M19 5l-3.6 3.6M8.6 15.4 5 19"/></svg>
                    <span>{{#str}}sd_help, theme_baz{{/str}}</span>
                </button>
            </div>
            {{/hassupport}}

            {{#hasaskjo}}
            <div class="sid-askjo-panel" id="sid-askjo-panel" hidden>
                <div class="sid-askjo-head"><span>{{#str}}sd_askjo, theme_baz{{/str}}</span><button type="button" class="sid-askjo-close" id="sid-askjo-close" aria-label="Close">&times;</button></div>
                <div class="block_openai_chat" data-instance-id="{{askjo.blockid}}">
                    <div class="sid-askjo-body">{{{ askjo.log }}}</div>
                    <div class="sid-askjo-control">{{{ askjo.control }}}</div>
                </div>
            </div>
            {{/hasaskjo}}
        </div>

        {{{ output.standard_after_main_region_html }}}
        {{{ output.standard_end_of_body_html }}}
    </div>
</body>
</html>
{{#js}}
    M.util.js_pending('theme_baz/loader');
    require(['theme_baz/loader', 'theme_baz/studentidcard'], function(Loader, StudentIdcard) {
        StudentIdcard.init();
        M.util.js_complete('theme_baz/loader');
    });
{{/js}}

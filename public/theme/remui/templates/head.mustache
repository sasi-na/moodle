{{!
    Page header.
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{! Default dark mode: set nighteyewState before any CSS/JS loads }}
    <script>
    (function() {
        // Default to dark mode for users who have never toggled
        if (localStorage.getItem('nighteyeuschedts') === null &&
            localStorage.getItem('nighteyewState') === null) {
            localStorage.setItem('nighteyewState', '1');
            document.cookie = 'ne_pl_m=1;path=/;SameSite=Lax';
        }
        // Apply nighteyeplgn attribute early so CSS dark styles apply before paint
        if (parseInt(localStorage.getItem('nighteyewState')) === 1) {
            document.documentElement.setAttribute('nighteyeplgn', 'active');
        } else {
            document.documentElement.setAttribute('nighteyeplgn', 'disabled');
        }
        // Inject dark mode color mappings from admin customizer settings
        {{#darkmodecolorsjson}}
        try {
            var _dmOpts = {{{darkmodecolorsjson}}};
            window.nightEyeProOptions = {
                darkTheme: 1,
                colorsBackground: _dmOpts.colorsBackground || {},
                colorsForeground: _dmOpts.colorsForeground || {}
            };
        } catch(e) {}
        {{/darkmodecolorsjson}}
    })();
    </script>
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        {{#fonts}}
            @import "https://fonts.googleapis.com/css?family={{.}}:100,200,300,400,500,600,700,800,900";
        {{/fonts}}
    </style>
</head>

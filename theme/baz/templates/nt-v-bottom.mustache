{{!
    @template theme_baz/nt-v-bottom

    Shared end of the Option 3-5 student dashboards (page content, help, scripts).
}}
            <div id="region-main-box" class="sd-region-main nv-region">
                <section id="region-main" aria-label="{{#str}}content{{/str}}">
                    {{{ output.main_content }}}
                </section>
            </div>

            {{#hassupport}}
            <div class="sd-help nt-help">
                <div class="sd-help-panel" id="sd-help-panel" hidden>
                    <div class="sd-help-head">
                        <div class="sd-help-t"><b>{{#str}}sd_help, theme_baz{{/str}}</b><small>{{#str}}sd_help_sub, theme_baz{{/str}}</small></div>
                        <button type="button" class="sd-help-close" id="sd-help-close" aria-label="{{#str}}closebuttontitle, core{{/str}}">&times;</button>
                    </div>
                    <div class="sd-blockcontent sd-support">{{{ support_html }}}</div>
                </div>
                <button type="button" class="sd-help-fab" id="sd-help-fab" aria-expanded="false" aria-controls="sd-help-panel">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M5 5l3.6 3.6M15.4 15.4 19 19M19 5l-3.6 3.6M8.6 15.4 5 19"/></svg>
                    <span>{{#str}}sd_help, theme_baz{{/str}}</span>
                </button>
            </div>
            {{/hassupport}}
        </div>

        {{{ output.standard_after_main_region_html }}}
        {{{ output.standard_end_of_body_html }}}
    </div>
    {{#ntwidgetsurl}}<script src="{{{ntwidgetsurl}}}" defer></script>{{/ntwidgetsurl}}
</body>
</html>
{{#js}}
    M.util.js_pending('theme_baz/loader');
    require(['theme_baz/loader', 'theme_baz/studentdashboard'], function(Loader, StudentDashboard) {
        StudentDashboard.init();
        M.util.js_complete('theme_baz/loader');
    });
    document.querySelectorAll('[data-nt-tabs]').forEach(function(box) {
        box.querySelectorAll('[data-nt-tab]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var key = btn.getAttribute('data-nt-tab');
                box.querySelectorAll('[data-nt-tab]').forEach(function(b) {
                    var on = b === btn;
                    b.classList.toggle('on', on);
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                box.querySelectorAll('[data-nt-pane]').forEach(function(p) {
                    p.hidden = p.getAttribute('data-nt-pane') !== key;
                });
            });
        });
    });
{{/js}}

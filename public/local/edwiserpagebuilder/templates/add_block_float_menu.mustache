{{!
    @template local_edwiserpagebuilder/add_block_float_menu

    TODO describe template add_block_float_menu

    Example context (json):
    {
    }
}}


{{#editing}}
<div class="position-relative">
    <div id="add-block-float-menu" class="floating-widget">
        <div class="btn-group dropup">
            <a class="btn btn-dark btn-lg d-flex align-items-center justify-content-center floating-add-block-button"  title="Add a block button"   type="button">
                {{! <span class="edw-icon edw-icon-brush large p-mr-1"></span> }}
                <span class="fa-solid fa-plus edw-icon edw-icon-Plus_24"></span>
                <span style="font-size: 14px;" style="font-weight: 600;">{{#str}}addblock, moodle{{/str}}</span>
            </a>
            <button type="button" class="btn btn-lg btn-dark dropdown-toggle dropdown-toggle-split add-block-split-icon-btn" data-bs-toggle="dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="sr-only">Toggle Dropdown</span>
                <span class="fa-solid fa-chevron-up edw-icon edw-icon-UpArrow large d-none"></span>
                <span class="fa-solid fa-chevron-down edw-icon edw-icon-Down-Arrow large"></span>
            </button>
            <div class="dropdown-menu">
               {{#regiondata}}
                    <a href="#" class="dropdown-item btn btn-lg edw-theme-region-link {{region}}-link" data-region="{{regionid}}" >
                        <span class="fa-solid fa-check edw-icon edw-icon-Check p-mr-1" style="font-size: 18px; font-weight: 600;"></span>
                        <span class="region-name-text text-left" style="font-size: 14px; font-weight: 600;">{{regionname}}</span>
                    </a>
               {{/regiondata}}
            </div>
        </div>
    </div>

    <div class="p-2 add-newpage-btn-wrapper">

        <a href="#" class="menu-item epb-addnewpage" title="Add a new custom page" data-asw-orgfontsize="16" style="font-size: 16px;">
            <i class="fa-regular fa-file" style="font-size: 20px;"></i>
        </a>
    </div>
</div>
    {{#js}}
    {! this is commmented due to js required from other place }
    {{#comment}}
    require(['jquery','local_edwiserpagebuilder/floating_add_block_handler'], function($,FLOATADDBLOCKHANLDER){
        $(document).ready(function(){
            FLOATADDBLOCKHANLDER.init();
        });
    });
    {{/comment}}
    {{/js}}

{{/editing}}
<style>
.dir-rtl:not([class^="edw-m"]) #add-block-float-menu {
    transform: translate(50%, 0);
}

.dir-rtl:not([class^="edw-m"]) #add-block-float-menu .dropdown-menu {
    transform: translate(50%, -103%) !important;
}
</style>

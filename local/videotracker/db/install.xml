<?xml version="1.0" encoding="UTF-8" ?>

<XMLDB PATH="local/videotracker/db"
       VERSION="2026050800"
       COMMENT="Video Tracker">

    <TABLES>

        <!-- Video tracking sessions -->

        <TABLE NAME="local_videotracker_session"
               COMMENT="Video tracking sessions">

            <FIELDS>

                <FIELD NAME="id"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       SEQUENCE="true"/>

                <FIELD NAME="userid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="courseid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="cmid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="videoid"
                       TYPE="char"
                       LENGTH="255"
                       NOTNULL="true"/>

                <!-- UUID for unique playback session -->

                <FIELD NAME="sessionuuid"
                       TYPE="char"
                       LENGTH="100"
                       NOTNULL="true"/>

                <FIELD NAME="startedat"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="endedat"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="false"/>

                <FIELD NAME="videoduration"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="watchedseconds"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="percentage"
                       TYPE="number"
                       LENGTH="5"
                       DECIMALS="2"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="completed"
                       TYPE="int"
                       LENGTH="1"
                       NOTNULL="true"
                       DEFAULT="0"/>

            </FIELDS>

            <KEYS>

                <KEY NAME="primary"
                     TYPE="primary"
                     FIELDS="id"/>

            </KEYS>

            <INDEXES>

                <!-- UUID lookup -->

                <INDEX NAME="sessionuuid_idx"
                       UNIQUE="true"
                       FIELDS="sessionuuid"/>

                <!-- Reporting indexes -->

                <INDEX NAME="userid_idx"
                       UNIQUE="false"
                       FIELDS="userid"/>

                <INDEX NAME="courseid_idx"
                       UNIQUE="false"
                       FIELDS="courseid"/>

                <INDEX NAME="cmid_idx"
                       UNIQUE="false"
                       FIELDS="cmid"/>

                <INDEX NAME="videoid_idx"
                       UNIQUE="false"
                       FIELDS="videoid"/>

                <INDEX NAME="completed_idx"
                       UNIQUE="false"
                       FIELDS="completed"/>

            </INDEXES>

        </TABLE>

        <!-- Zoom recording summaries -->

        <TABLE NAME="local_zoom_recording_summary"
               COMMENT="Zoom recording summaries">

            <FIELDS>

                <FIELD NAME="id"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       SEQUENCE="true"/>

                <FIELD NAME="userid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="courseid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="cmid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="videoid"
                       TYPE="char"
                       LENGTH="255"
                       NOTNULL="true"/>

                <!-- Zoom meeting ID stored as text -->

                <FIELD NAME="zoommeetingid"
                       TYPE="char"
                       LENGTH="100"
                       NOTNULL="false"/>

                <FIELD NAME="sessionid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="summary"
                       TYPE="text"
                       NOTNULL="true"/>

                <FIELD NAME="wordcount"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <!-- 0 = Pending, 1 = Approved, 2 = Rejected -->

                <FIELD NAME="status"
                       TYPE="int"
                       LENGTH="1"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="reviewedby"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="reviewedat"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <FIELD NAME="feedback"
                       TYPE="text"
                       NOTNULL="false"/>

                <FIELD NAME="submittedat"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"/>

                <!-- Number of submissions; 1 = first, 2 = resubmitted once -->

                <FIELD NAME="attempts"
                       TYPE="int"
                       LENGTH="2"
                       NOTNULL="true"
                       DEFAULT="1"/>

            </FIELDS>

            <KEYS>

                <KEY NAME="primary"
                     TYPE="primary"
                     FIELDS="id"/>

            </KEYS>

            <INDEXES>

                <!-- Prevent duplicate summaries -->

                <INDEX NAME="uniq_user_video"
                       UNIQUE="true"
                       FIELDS="userid,cmid,videoid"/>

                <!-- Reporting indexes -->

                <INDEX NAME="userid_idx"
                       UNIQUE="false"
                       FIELDS="userid"/>

                <INDEX NAME="courseid_idx"
                       UNIQUE="false"
                       FIELDS="courseid"/>

                <INDEX NAME="cmid_idx"
                       UNIQUE="false"
                       FIELDS="cmid"/>

                <INDEX NAME="videoid_idx"
                       UNIQUE="false"
                       FIELDS="videoid"/>

                <INDEX NAME="zoommeetingid_idx"
                       UNIQUE="false"
                       FIELDS="zoommeetingid"/>

                <INDEX NAME="sessionid_idx"
                       UNIQUE="false"
                       FIELDS="sessionid"/>

            </INDEXES>

        </TABLE>

    </TABLES>

</XMLDB>
{{!
    @template theme_baz/mycourses-header

    Greeting banner with course stats for the My Courses page. All three
    tiles are filled by theme_baz/mycourses from the myoverview block's own
    course data, so the numbers always describe the same course set.

    Example context (json):
    {
        "userfirstname": "Aisha"
    }
}}
<div class="rui-mycourses-header" data-region="mycourses-header">
    <div class="rui-mycourses-header-greeting">
        <h2 class="rui-mycourses-header-title">{{#str}} welcomeback, theme_baz, {{userfirstname}} {{/str}}</h2>
        <p class="rui-mycourses-header-subtitle">{{#str}} mycoursesheadersub, theme_baz {{/str}}</p>
    </div>
    <div class="rui-mycourses-stats" data-region="mycourses-stats">
        <div class="rui-mycourses-stat">
            <span class="rui-mycourses-stat-value rui-skeleton" data-region="mycourses-stat-total">&nbsp;</span>
            <span class="rui-mycourses-stat-label">{{#str}} totalcourses, theme_baz {{/str}}</span>
        </div>
        <div class="rui-mycourses-stat">
            <span class="rui-mycourses-stat-value rui-skeleton" data-region="mycourses-stat-inprogress">&nbsp;</span>
            <span class="rui-mycourses-stat-label">{{#str}} inprogress, block_myoverview {{/str}}</span>
        </div>
        <div class="rui-mycourses-stat">
            <span class="rui-mycourses-stat-value rui-skeleton" data-region="mycourses-stat-completed">&nbsp;</span>
            <span class="rui-mycourses-stat-label">{{#str}} completed, completion {{/str}}</span>
        </div>
    </div>
</div>

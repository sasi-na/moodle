{{#isedwiserformat}}
<div class="course-details-header">
    <div class="course-sub-header1 d-flex align-items-center">
        {{#coursedata}}
            <div class="coursename text-clamp text-clamp-1">
                <a href="{{courseurl}}" class="text-decoration-none"><span class="fa fa-arrow-left fa-fw"></span> {{coursename}}</a>
            </div>
        {{/coursedata}}
    </div>

    <div class="course-sub-header2">
        <div class="progress-details">
            <div class="progress-text">
                Course progress
            </div>

            <div class="course-percentage">
                <div class="progress-bar" style="width: {{courseprogress}}%;"></div>
                <span>{{courseprogress}}%</span>
            </div>
        </div>

        <div class="rest-progress">
            <i class="icon fa fa-ellipsis-vertical fa-fw " role="img" aria-label="Edit"></i>

            <div class="progress-dropdown">
                <div class="lesson-progress">
                    <span class="edw-icon edw-icon-Book" title="lessons"></span>
                    <p class="text">Lessons done:</p>
                    <p class="lessoncount">{{completed}}/{{total}}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{{/isedwiserformat}}

{{!
    @template theme_baz/nt-topbar-admin

    Top bar of the admin dashboards (Option 2 and Options 3-5).
}}
            <header class="nt-top" id="nt-shellbar">
                <div class="nt-top-inner">
                    <a class="nt-brand" href="{{{ config.wwwroot }}}/my/">
                        {{#customsidebarlogo}}<img src="{{customsidebarlogo}}" alt="{{sitename}}">{{/customsidebarlogo}}
                        {{^customsidebarlogo}}{{#customlogo}}<img src="{{customlogo}}" alt="{{sitename}}">{{/customlogo}}{{^customlogo}}<span>{{{ sitename }}}</span>{{/customlogo}}{{/customsidebarlogo}}
                    </a>
                    <nav class="nt-nav" aria-label="{{#str}}nt_mainnav, theme_baz{{/str}}">
                        <a href="{{{ config.wwwroot }}}/my/" class="on" aria-current="page"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2"/></svg>{{#str}}sd_nav_dashboard, theme_baz{{/str}}</a>
                        <a href="{{mycoursesurl}}"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="13" rx="1.5"/><path d="M3 20h18"/></svg>{{#str}}sd_nav_courses, theme_baz{{/str}}</a>
                        <a href="{{calendarurl}}"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>{{#str}}sd_nav_calendar, theme_baz{{/str}}</a>
                        <a href="{{ntsiteadminurl}}"><svg viewBox="0 0 24 24"><path d="M6 4v16M12 4v16M18 4v16"/><circle cx="6" cy="9" r="2" fill="currentColor"/><circle cx="12" cy="15" r="2" fill="currentColor"/><circle cx="18" cy="8" r="2" fill="currentColor"/></svg>{{#str}}administrationsite, core{{/str}}</a>
                    </nav>
                    <div class="nt-top-right">
                        <div class="sd-search-wrap nt-search-wrap">
                            <form class="nt-search" action="{{settingsurl}}" method="get" role="search">
                                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                                <input type="text" name="query" id="sd-search-input" autocomplete="off" placeholder="{{#str}}search, core{{/str}}" aria-label="{{#str}}search, core{{/str}}">
                                <span class="nt-kbd">/</span>
                            </form>
                        </div>
                        <button type="button" class="nt-iconbtn" id="sd-themebtn" title="{{#str}}sd_toggletheme, theme_baz{{/str}}">
                            <svg id="sd-themeicon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        </button>
                        <div class="nt-editswitch">{{{ output.edit_switch }}}</div>
                        <div class="nt-plugins nt-actions">{{{ output.navbar_plugin_output }}}</div>
                        <div class="nt-usermenu">{{{ output.user_menu }}}</div>
                    </div>
                </div>
            </header>

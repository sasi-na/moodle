{{!
    @template mod_assign/file_preview_modal

    Body of the faculty "preview submitted file" modal (Jain customisation).

    Context variables required for this template:
    * filename - The name of the file being previewed.
    * downloadurl - URL to download the file (force download).
    * src - URL to render in the preview (image src, iframe src, or native media src).
    * isimage - Whether to render the preview as an image.
    * isembed - Whether to render the preview in an iframe (PDF / text / Office viewer).
    * ismedia - Whether to render pre-built media player markup from embedhtml.
    * embedhtml - Server-built media player markup (Video.js), used when ismedia is set.
    * isvideo - Whether to render a native video element (fallback when no media player applies).
    * isaudio - Whether to render a native audio element (fallback when no media player applies).
    * notavailable - Whether no inline preview is available for this file type.

    Example context (json):
    {
        "filename": "presentation.mp4",
        "downloadurl": "https://moodle/pluginfile.php/...?forcedownload=1",
        "src": "https://moodle/pluginfile.php/...",
        "isimage": false,
        "isembed": false,
        "ismedia": true,
        "embedhtml": "<div class=\"mediaplugin mediaplugin_videojs\">...</div>",
        "isvideo": false,
        "isaudio": false,
        "notavailable": false
    }
}}
<div class="assign-file-preview-modal">
    {{#isimage}}
        <div class="text-center">
            <img src="{{src}}" alt="{{filename}}" class="img-fluid assign-file-preview-image">
        </div>
    {{/isimage}}
    {{#isembed}}
        <iframe src="{{src}}" title="{{filename}}" class="w-100 assign-file-preview-frame"></iframe>
    {{/isembed}}
    {{#ismedia}}
        <div class="assign-file-preview-media">{{{embedhtml}}}</div>
    {{/ismedia}}
    {{#isvideo}}
        <div class="assign-file-preview-media">
            <video src="{{src}}" title="{{filename}}" controls preload="metadata" class="w-100"></video>
        </div>
    {{/isvideo}}
    {{#isaudio}}
        <div class="assign-file-preview-media">
            <audio src="{{src}}" title="{{filename}}" controls preload="metadata" class="w-100"></audio>
        </div>
    {{/isaudio}}
    {{#notavailable}}
        <div class="alert alert-info" role="alert">
            {{#str}}previewnotavailable, assignsubmission_file{{/str}}
        </div>
    {{/notavailable}}
    <div class="mt-3 text-right">
        <a href="{{downloadurl}}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            {{#str}}download, assignsubmission_file{{/str}}
        </a>
    </div>
</div>

{{!
    @template mod_quiz/ai_feedback

    AI feedback section for quiz review page.

    Context variables required for this template:
    * contextid - The context ID
    * attemptid - The attempt ID
    * prompt - The AI prompt text
}}
<div class="quiz-ai-feedback mb-4" id="quiz-ai-feedback-{{attemptid}}" data-contextid="{{contextid}}" data-attemptid="{{attemptid}}" data-autoload="true">
    <textarea class="d-none quiz-ai-feedback-prompt-data">{{prompt}}</textarea>
    <div class="card shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0">
                    <span>{{#str}}aifeedback, mod_quiz{{/str}}</span>
                </h5>
                <button type="button" class="btn btn-sm btn-primary quiz-ai-feedback-regenerate d-none" data-action="regenerate">
                    <i class="icon fa fa-refresh fa-fw"></i>
                    {{#str}}regenerate, mod_quiz{{/str}}
                </button>
            </div>
        </div>
        <div class="card-body quiz-ai-feedback-content p-4">
            <div class="quiz-ai-feedback-loading text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="sr-only">{{#str}}loading{{/str}}</span>
                </div>
                <p class="text-muted mb-0">{{#str}}generatingfeedback, mod_quiz{{/str}}</p>
            </div>
            <div class="quiz-ai-feedback-result d-none">
                <div class="quiz-ai-feedback-text" style="line-height: 1.8; font-size: 0.95rem;"></div>
            </div>
            <div class="quiz-ai-feedback-error d-none">
                <div class="alert alert-danger mb-0">
                    <div class="d-flex align-items-start">
                        <i class="icon fa fa-exclamation-triangle fa-fw mt-1 mr-2"></i>
                        <div class="flex-grow-1">
                            <strong>Error:</strong>
                            <span class="quiz-ai-feedback-error-message"></span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-danger mt-3" data-action="retry">
                        <i class="icon fa fa-redo fa-fw"></i>
                        {{#str}}tryagain, mod_quiz{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{{!
    @template local_helpdesk/categories

    Example context (json):
    {
      "rows": [
        {"id": 1, "name": "Root", "description": "Desc", "depth": 0, "is_root": true, "indent_style": "", "has_categorydelete": true},
        {"id": 2, "name": "Child", "description": "Desc", "depth": 1, "is_root": false, "indent_style": "padding-left:25px;", "has_categorydelete": true}
      ]
    }
}}

<table class="generaltable">
    <thead>
    <tr>
        <th>{{#str}}categoryname, local_helpdesk{{/str}}</th>
        <th>{{#str}}categorydescription, local_helpdesk{{/str}}</th>
        <th style="white-space: nowrap; width: 190px;">&nbsp;</th>
    </tr>
    </thead>
    <tbody>
    {{#rows}}
        <tr class="{{#is_root}}helpdesk-parent-category{{/is_root}}{{^is_root}}helpdesk-subcategory{{/is_root}}"
            {{^is_root}}style="background-color:#f8f9fa;"{{/is_root}}>
            <td style="{{{indent_style}}}">
                {{^is_root}}↳ {{/is_root}}
                {{#is_root}}<strong>{{name}}</strong>{{/is_root}}
                {{^is_root}}{{name}}{{/is_root}}
            </td>
            <td>{{description}}</td>
            <td style="white-space: nowrap; width: 190px;">
                <a href="?actionform=edit&amp;id={{id}}" class="badge badge-success">{{#str}}edit{{/str}}</a>
                {{#has_categorydelete}}
                    <a href="?actionform=delete&amp;id={{id}}" class="badge badge-danger">{{#str}}delete{{/str}}</a>
                {{/has_categorydelete}}
                <a href="?actionform=add&amp;parentid={{id}}" class="badge badge-info">+ Sub</a>
            </td>
        </tr>
    {{/rows}}
    </tbody>
</table>

<p><a href="{{{config.wwwroot}}}/local/helpdesk/categories.php?actionform=add"
      class="btn btn-info">{{#str}}addcategory, local_helpdesk{{/str}}</a></p>

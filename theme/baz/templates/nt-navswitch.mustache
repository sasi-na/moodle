{{!
    @template theme_baz/nt-navswitch

    Quick Navigation switch (theme/baz/navigation.php): one card per option.
}}
<div class="nvq">
    <p class="nvq-intro">{{intro}}</p>
    <div class="nvq-grid">
        {{#cards}}
        <form class="nvq-card{{#current}} is-current{{/current}}" method="post" action="{{action}}" style="--c1:{{c1}};--c2:{{c2}};--bg:{{bg}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="layout" value="{{key}}">
            <div class="nvq-prev nvq-prev-{{key}}" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
            <div class="nvq-body">
                <span class="nvq-num">{{num}}</span>
                <h3>{{name}}</h3>
                <p>{{desc}}</p>
            </div>
            {{#current}}<span class="nvq-btn nvq-on">✓ {{#str}}nvq_current, theme_baz{{/str}}</span>{{/current}}
            {{^current}}<button type="submit" class="nvq-btn">{{#str}}nvq_apply, theme_baz{{/str}}</button>{{/current}}
        </form>
        {{/cards}}
    </div>
    {{#reset}}
    <form class="nvq-reset" method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="layout" value="default">
        {{#canreset}}<button type="submit" class="btn btn-secondary">{{#str}}ms_sitedefault, theme_baz{{/str}}</button>{{/canreset}}
    </form>
    {{#isadmin}}
    <form class="nvq-admdef" method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="applyall" value="1">
        <button type="submit" class="btn btn-primary">{{applyalllabel}}</button>
        <span>{{applyallhelp}}</span>
    </form>
    {{/isadmin}}
    {{/reset}}
    {{#settingsurl}}<p class="nvq-more"><a href="{{settingsurl}}">{{#str}}nvq_allsettings, theme_baz{{/str}} →</a></p>{{/settingsurl}}
</div>
<style>
.nvq { max-width: 1180px; }
.nvq-intro { color: #5c7184; margin-bottom: 18px; }
.nvq-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
.nvq-card { display: flex; flex-direction: column; background: #fff; border: 1px solid #e5ecf3; border-radius: 18px; overflow: hidden; box-shadow: 0 10px 26px -20px rgba(11, 32, 52, .5); margin: 0; }
.nvq-card.is-current { border-color: var(--c1); box-shadow: 0 0 0 2px var(--c1), 0 14px 30px -20px rgba(11, 32, 52, .6); }
.nvq-prev { position: relative; height: 112px; background: var(--bg); }
.nvq-prev i { position: absolute; display: block; border-radius: 6px; }
.nvq-prev .a { background: var(--c1); }
.nvq-prev .b { background: var(--c2); }
.nvq-prev .c, .nvq-prev .d { background: #fff; box-shadow: 0 2px 6px rgba(0, 0, 0, .08); }
.nvq-prev-left .a { left: 0; top: 0; bottom: 0; width: 26%; border-radius: 0; } .nvq-prev-left .b { left: 6%; top: 14%; width: 14%; height: 8%; }
.nvq-prev-left .c { left: 32%; top: 14%; right: 6%; height: 34%; } .nvq-prev-left .d { left: 32%; top: 56%; right: 6%; height: 32%; }
.nvq-prev-top .a { left: 0; right: 0; top: 0; height: 22%; border-radius: 0; } .nvq-prev-top .b { left: 40%; top: 6%; width: 14%; height: 10%; border-radius: 9px; }
.nvq-prev-top .c { left: 6%; top: 32%; right: 6%; height: 26%; } .nvq-prev-top .d { left: 6%; top: 64%; width: 42%; height: 26%; }
.nvq-prev-rail .a { right: 6%; top: 8%; width: 18%; height: 14%; border-radius: 999px; } .nvq-prev-rail .b { left: 6%; top: 30%; width: 50%; height: 60%; border-radius: 12px; opacity: .3; }
.nvq-prev-rail .c { left: 60%; top: 30%; right: 6%; height: 27%; } .nvq-prev-rail .d { left: 60%; top: 62%; right: 6%; height: 28%; }
.nvq-prev-dock .a { left: 0; right: 0; top: 0; height: 18%; border-radius: 0; background: linear-gradient(90deg, var(--c1), #f97316); } .nvq-prev-dock .b { left: 28%; right: 28%; bottom: 8%; height: 14%; border-radius: 999px; background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,.15); }
.nvq-prev-dock .c { left: 6%; top: 26%; right: 6%; height: 30%; } .nvq-prev-dock .d { left: 6%; top: 60%; width: 40%; height: 14%; }
.nvq-prev-campus .a { left: 0; right: 0; top: 0; height: 20%; border-radius: 0; } .nvq-prev-campus .b { left: 36%; right: 36%; top: 24%; height: 4%; }
.nvq-prev-campus .c { left: 6%; top: 36%; width: 58%; height: 54%; border-radius: 2px; } .nvq-prev-campus .d { left: 68%; top: 36%; right: 6%; height: 54%; border-radius: 2px; }
.nvq-body { padding: 14px 16px 6px; flex: 1; }
.nvq-num { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 8px; background: var(--c1); color: #fff; font-weight: 800; font-size: 12px; }
.nvq-body h3 { font-size: 15px; font-weight: 800; margin: 8px 0 4px; }
.nvq-body p { font-size: 12.5px; color: #5c7184; margin: 0; line-height: 1.45; }
.nvq-btn { margin: 12px 16px 16px; height: 40px; border: 0; border-radius: 12px; background: var(--c1); color: #fff; font-weight: 700; cursor: pointer; display: grid; place-items: center; }
.nvq-btn:hover { filter: brightness(1.08); }
.nvq-on { background: #e6f6ee; color: #16a34a; cursor: default; }
.nvq-more { margin-top: 18px; }
.nvq-admdef { margin-top: 14px; padding-top: 14px; border-top: 1px solid #e5ecf3; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.nvq-reset { margin-top: 18px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; color: #5c7184; }
</style>

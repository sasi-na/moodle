{{!
    @template mod_forum/forum_search_results

    theme_baz: render each matching post as a compact result card — a
    forum/discussion breadcrumb, the message snippet (with search highlights),
    the author byline and a link to the post in context. All data comes from
    the standard search post export (urls.view, message, html.authorsubheading,
    the subject-with-context-links partial), so search behaviour is unchanged.
}}
<div class="baz-fsr-list">
{{#posts}}
    <article class="baz-fsr">
        <div class="baz-fsr-crumb">
            {{> mod_forum/forum_post_subject_with_context_links }}
        </div>
        <div class="baz-fsr-snip">{{{message}}}</div>
        <div class="baz-fsr-foot">
            <span class="baz-fsr-by">{{{html.authorsubheading}}}</span>
            <a class="baz-fsr-cta" href="{{{urls.view}}}">
                {{#str}}postincontext, mod_forum{{/str}}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" fill="none" stroke-width="2.2"/></svg>
            </a>
        </div>
    </article>
{{/posts}}
</div>

{{!
    @template theme_baz/nt-student-campus

    Option 5 - Campus classic: lead story, this week's timetable,
    course catalogue, reading-list shelf, thought of the day, word of the day, campus almanac,
    pinned notice board and the press - in a warm paper, serif, broadsheet layout.
    Same data as theme_baz/nt-student-dashboard (output\nt_student_dashboard).
}}
{{> theme_baz/nt-v-top }}
            <main class="nv-main nv-journal" data-nv-uid="{{ntuserid}}">

                <header class="nv-masthead">
                    <div class="nv-mast-row"><span>{{datelabel}}</span><span>{{#hassemester}}{{#str}}sd_semshort, theme_baz, {{semesternum}}{{/str}}{{/hassemester}}</span></div>
                    <h1 class="nv-hello">{{ntgreeting}}</h1>
                    <p class="nv-sub">{{{ntsubline}}}</p>
                </header>

                <div class="nv-paper">
                    <div class="nv-lead">
                        <article class="nv-story">
                            <span class="nv-section">{{#str}}nv_continue, theme_baz{{/str}}</span>
                            {{#hasfocus}}
                            <h2 class="nv-headline"><a href="{{focus.url}}">{{ntfocusname}}</a></h2>
                            <p class="nv-standfirst">{{focus.statuslabel}} — <b>{{ntfocuspct}}%</b> {{#str}}sd_completed, theme_baz{{/str}}{{#ntfocusstats}}{{#ntfocushastotal}}, {{ntfocusdone}}/{{ntfocustotal}} {{#str}}nt_f_activities, theme_baz{{/str}}{{/ntfocushastotal}}{{/ntfocusstats}}.</p>
                            <div class="nv-rule"><i style="width:{{ntfocuspct}}%"></i></div>
                            {{#ntfocusstats}}{{#ntfocushasnext}}{{#ntfocusnext}}
                            <a class="nv-next" href="{{url}}"><span class="nv-next-ic"><svg viewBox="0 0 24 24">{{{icon}}}</svg></span><span><small>{{#str}}nt_f_upnext, theme_baz{{/str}} · {{kind}}</small><b>{{name}}</b></span></a>
                            {{/ntfocusnext}}{{/ntfocushasnext}}{{/ntfocusstats}}
                            {{/hasfocus}}
                            {{^hasfocus}}<h2 class="nv-headline">{{#str}}nt_nofocus, theme_baz{{/str}}</h2>{{/hasfocus}}
                            <div class="nv-actions">
                                {{#resumeitem}}<a class="nv-btn" href="{{url}}" title="{{name}}">{{#str}}sd_resume, theme_baz{{/str}} →</a>{{/resumeitem}}
                                {{^resumeitem}}{{#hasfocus}}<a class="nv-btn" href="{{focus.url}}">{{#str}}sd_focusgo, theme_baz{{/str}} →</a>{{/hasfocus}}{{/resumeitem}}
                                {{#showexamcta}}<a class="nv-btn nv-btn-soft" href="{{examctaurl}}">{{#str}}sd_exam_start, theme_baz{{/str}}</a>{{/showexamcta}}
                            </div>
                            <span class="nv-bigpct" aria-hidden="true">{{ringpct}}<small>%</small></span>
                        </article>

                        <section class="nv-gcalc" data-nv-gcalc data-nv-help="{{#str}}nv_h_gcalc, theme_baz{{/str}}" data-nv-tips="{{#str}}nv_tips_gcalc, theme_baz{{/str}}" data-t-hint="{{#str}}nv_g_hint, theme_baz{{/str}}" data-t-sofar="{{#str}}nv_g_sofar, theme_baz{{/str}}" data-t-need="{{#str}}nv_g_need, theme_baz{{/str}}" data-t-hard="{{#str}}nv_g_hard, theme_baz{{/str}}" data-t-safe="{{#str}}nv_g_safe, theme_baz{{/str}}" data-t-name="{{#str}}nv_g_name, theme_baz{{/str}}" data-t-weight="{{#str}}nv_g_weight, theme_baz{{/str}}" data-t-score="{{#str}}nv_g_score, theme_baz{{/str}}">
                            <h3 class="nv-section">{{#str}}nv_gcalc, theme_baz{{/str}}</h3>
                            <p class="nvw-lead">{{#str}}nv_g_lead, theme_baz{{/str}}</p>
                            <div class="nvw-rowhead"><span>{{#str}}nv_g_name, theme_baz{{/str}}</span><span>{{#str}}nv_g_weight, theme_baz{{/str}}</span><span>{{#str}}nv_g_score, theme_baz{{/str}}</span><span></span></div>
                            <ul class="nvw-rows" data-rows></ul>
                            <div class="nvw-gfoot">
                                <button type="button" data-add class="nvw-add">+ {{#str}}nv_g_addrow, theme_baz{{/str}}</button>
                                <label>{{#str}}nv_g_target, theme_baz{{/str}} <input type="number" min="1" max="100" data-target inputmode="numeric"></label>
                            </div>
                            <p class="nvw-result" data-out></p>
                        </section>

                        <section class="nv-cite" data-nv-cite data-nv-help="{{#str}}nv_h_cite, theme_baz{{/str}}" data-nv-tips="{{#str}}nv_tips_cite, theme_baz{{/str}}" data-t-hint="{{#str}}nv_cite_hint, theme_baz{{/str}}" data-t-noauthor="{{#str}}nv_cite_noauthor, theme_baz{{/str}}" data-t-done="">
                            <h3 class="nv-section">{{#str}}nv_cite, theme_baz{{/str}}</h3>
                            <p class="nvw-lead">{{#str}}nv_cite_lead, theme_baz{{/str}}</p>
                            <div class="nvw-cgrid">
                                <label><span>{{#str}}nv_cite_style, theme_baz{{/str}}</span><select data-f="style"><option value="apa">APA 7</option><option value="mla">MLA 9</option><option value="harvard">Harvard</option></select></label>
                                <label><span>{{#str}}nv_cite_year, theme_baz{{/str}}</span><input type="text" maxlength="4" data-f="year" placeholder="2026"></label>
                                <label class="wide"><span>{{#str}}nv_cite_author, theme_baz{{/str}}</span><input type="text" maxlength="80" data-f="author" placeholder="Sharma, A."></label>
                                <label class="wide"><span>{{#str}}nv_cite_title, theme_baz{{/str}}</span><input type="text" maxlength="160" data-f="title"></label>
                                <label><span>{{#str}}nv_cite_site, theme_baz{{/str}}</span><input type="text" maxlength="80" data-f="site"></label>
                                <label><span>URL</span><input type="url" maxlength="200" data-f="url" placeholder="https://"></label>
                            </div>
                            <p class="nvw-cout" data-out></p>
                            <button type="button" class="nvw-copy" data-copy data-done="{{#str}}nv_cite_copied, theme_baz{{/str}}">{{#str}}nv_cite_copy, theme_baz{{/str}}</button>
                        </section>

                        {{#hasrecent}}
                        <section class="nv-shelfbox">
                            <h3 class="nv-section">{{#str}}nv_readinglist, theme_baz{{/str}}</h3>
                            <div class="nv-shelf">
                                {{#recentitems}}<a class="nv-book" href="{{url}}" style="--c:{{iconcolor}}" title="{{name}} · {{coursename}}"><span class="nv-book-k">{{kind}}</span><span class="nv-book-t">{{name}}</span></a>{{/recentitems}}
                            </div>
                        </section>
                        {{/hasrecent}}
                    </div>

                    <aside class="nv-sidecol">
                        <section class="nv-box nv-quote" data-nv-daily>
                            <h3 class="nv-section">{{#str}}nv_thought, theme_baz{{/str}}</h3>
                            <blockquote data-nv-item>{{#str}}nv_quote1, theme_baz{{/str}}</blockquote><blockquote data-nv-item hidden>{{#str}}nv_quote2, theme_baz{{/str}}</blockquote><blockquote data-nv-item hidden>{{#str}}nv_quote3, theme_baz{{/str}}</blockquote><blockquote data-nv-item hidden>{{#str}}nv_quote4, theme_baz{{/str}}</blockquote><blockquote data-nv-item hidden>{{#str}}nv_quote5, theme_baz{{/str}}</blockquote><blockquote data-nv-item hidden>{{#str}}nv_quote6, theme_baz{{/str}}</blockquote><blockquote data-nv-item hidden>{{#str}}nv_quote7, theme_baz{{/str}}</blockquote>
                        </section>

                        <section class="nv-box nv-word" data-nv-daily>
                            <h3 class="nv-section">{{#str}}nv_wordday, theme_baz{{/str}}</h3>
                            <p data-nv-item>{{#str}}nv_word1, theme_baz{{/str}}</p><p data-nv-item hidden>{{#str}}nv_word2, theme_baz{{/str}}</p><p data-nv-item hidden>{{#str}}nv_word3, theme_baz{{/str}}</p><p data-nv-item hidden>{{#str}}nv_word4, theme_baz{{/str}}</p><p data-nv-item hidden>{{#str}}nv_word5, theme_baz{{/str}}</p><p data-nv-item hidden>{{#str}}nv_word6, theme_baz{{/str}}</p><p data-nv-item hidden>{{#str}}nv_word7, theme_baz{{/str}}</p>
                        </section>

                        <section class="nv-box nv-almanac">
                            <h3 class="nv-section">{{#str}}nv_almanac, theme_baz{{/str}}</h3>
                            <dl>
                                <dt>{{#hassemester}}{{#str}}nt_semprogress, theme_baz, {{semesternum}}{{/str}}{{/hassemester}}{{^hassemester}}{{#str}}sd_semprogress, theme_baz{{/str}}{{/hassemester}}</dt><dd>{{ringpct}}%</dd>
                                <dt>{{#str}}nv_almanac_courses, theme_baz{{/str}}</dt><dd>{{coursecount}}</dd>
                                <dt>{{#str}}nv_almanac_today, theme_baz{{/str}}</dt><dd data-nv-dayofyear>—</dd>
                                {{#nthasnexthol}}{{#ntnexthol}}<dt>{{#str}}nt_nextholiday, theme_baz{{/str}}</dt><dd>{{name}} <small>{{date}}</small></dd>{{/ntnexthol}}{{/nthasnexthol}}
                            </dl>
                        </section>

                        <section class="nv-box nv-board">
                            <h3 class="nv-section">{{#str}}nv_notices, theme_baz{{/str}}{{#ntnewsurl}} <a href="{{ntnewsurl}}">{{#str}}nt_viewall, theme_baz{{/str}}</a>{{/ntnewsurl}}</h3>
                            {{#nthasnews}}<div class="nv-pins">{{#ntnews}}<a class="nv-pin" href="{{url}}"><b>{{title}}</b><small>{{where}} · {{date}}</small></a>{{/ntnews}}</div>{{/nthasnews}}
                            {{^nthasnews}}<p class="nv-empty">{{#str}}nt_nonews, theme_baz{{/str}}</p>{{/nthasnews}}
                        </section>

                        {{#hasfee}}<section class="nv-box nv-fee"><h3 class="nv-section">{{fee.title}}</h3><p>{{fee.desc}}</p><a class="nv-btn" href="{{fee.payurl}}" target="_blank" rel="noopener">{{fee.button}} →</a></section>{{/hasfee}}

                        {{#hasbusinessnews}}
                        <section class="nv-box">
                            <h3 class="nv-section">{{#str}}nv_fromthepress, theme_baz{{/str}}</h3>
                            <ul class="nv-news">{{#businessnews}}<li><a href="{{url}}" target="_blank" rel="noopener"><b>{{title}}</b><small>{{source}}</small></a></li>{{/businessnews}}</ul>
                        </section>
                        {{/hasbusinessnews}}
                    </aside>
                </div>

                <p class="nv-footnote">{{brandfootnote}}</p>
            </main>
{{> theme_baz/nt-v-bottom }}

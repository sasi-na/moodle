{{!
  @template local_studentid/student_dashboard
  Student ID card request dashboard.
}}
<div class="local-studentid-dashboard container-fluid py-4">

  <div class="d-flex align-items-center mb-4">
    <span class="fa fa-id-card fa-2x text-primary mr-3"></span>
    <div>
      <h2 class="mb-0">{{#str}}pluginname, local_studentid{{/str}}</h2>
      <small class="text-muted">{{student_name}} &bull; USN: {{usn}}</small>
    </div>
  </div>

  {{#show_stepper}}
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="sid-stepper">
        {{#steps}}
        <div class="sid-step {{#done}}done{{/done}} {{#active}}active{{/active}}">
          <div class="sid-step-dot"><span class="{{icon}}"></span></div>
          <div class="sid-step-label">{{label}}</div>
        </div>
        {{/steps}}
      </div>
    </div>
  </div>
  {{/show_stepper}}

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="row align-items-center">

        <div class="col-md-5 mb-3 mb-md-0">
          <h5 class="card-title mb-1">{{#str}}request_status, local_studentid{{/str}}</h5>
          {{#has_request}}
            <span class="{{statusbadge}} px-3 py-1" style="font-size:1rem">{{status}}</span>
          {{/has_request}}
          {{^has_request}}
            <span class="badge bg-secondary text-white px-3 py-1" style="font-size:1rem">
              {{#str}}no_request_yet, local_studentid{{/str}}
            </span>
          {{/has_request}}
        </div>

        <div class="col-md-7">
          <div class="d-flex flex-wrap">

            {{#can_new_request}}
            <a href="{{request_url}}" class="btn btn-primary mr-2 mb-2">
              <span class="fa fa-plus-circle mr-1"></span>
              {{#str}}requestnewid, local_studentid{{/str}}
            </a>
            {{/can_new_request}}

            {{#can_edit_draft}}
            <a href="{{edit_url}}" class="btn btn-outline-secondary mr-2 mb-2">
              <span class="fa fa-edit mr-1"></span>
              {{#str}}editdraft, local_studentid{{/str}}
            </a>
            {{/can_edit_draft}}

            {{#can_submit_draft}}
            <a href="index.php?action=submit&sesskey={{sesskey}}"
               class="btn btn-success mr-2 mb-2"
               data-sid-confirm="{{#str}}confirm_submit, local_studentid{{/str}}">
              <span class="fa fa-paper-plane mr-1"></span>
              {{#str}}submitrequest, local_studentid{{/str}}
            </a>
            {{/can_submit_draft}}

            {{#can_download}}
            <a href="{{download_url}}" target="_blank" class="btn btn-info mr-2 mb-2">
              <span class="fa fa-download mr-1"></span>
              {{#str}}downloadid, local_studentid{{/str}}
            </a>
            {{/can_download}}

            {{#can_update_info}}
            <a href="index.php?action=update&sesskey={{sesskey}}"
               class="btn btn-outline-secondary mr-2 mb-2"
               title="Refresh your city, state and USN from your profile">
              <span class="fa fa-refresh mr-1"></span>
              {{#str}}updateinfo, local_studentid{{/str}}
            </a>
            {{/can_update_info}}

          </div>
        </div>
      </div>

      {{#can_update_info}}
      <p class="text-muted small mt-2 mb-0 fst-italic">
        <span class="fa fa-info-circle mr-1"></span>{{#str}}updateinfo_note, local_studentid{{/str}}
      </p>
      {{/can_update_info}}

      {{#has_download_stats}}
      <div class="mt-3 pt-2 border-top">
        <small class="text-muted">
          <span class="fa fa-bar-chart mr-1"></span>
          {{download_count_text}}
          &bull;
          {{#str}}lastdownloaded, local_studentid{{/str}}: {{last_downloaded}}
        </small>
      </div>
      {{/has_download_stats}}

      {{#is_rejected}}
      <div class="alert alert-danger mt-3 mb-0">
        <strong><span class="fa fa-times-circle mr-1"></span>{{#str}}request_rejected_title, local_studentid{{/str}}</strong>
        {{#reject_comment}}<p class="mb-0 mt-1">{{reject_comment}}</p>{{/reject_comment}}
        <p class="mb-0 mt-2 small">{{#str}}request_rejected_hint, local_studentid{{/str}}</p>
      </div>
      {{/is_rejected}}
    </div>
  </div>

  {{#can_new_request}}
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
      <strong><span class="fa fa-camera mr-1"></span>{{#str}}photo_guidelines_title, local_studentid{{/str}}</strong>
    </div>
    <div class="card-body">
      <ul class="mb-0">
        <li>{{#str}}photo_guide_1, local_studentid{{/str}}</li>
        <li>{{#str}}photo_guide_2, local_studentid{{/str}}</li>
        <li>{{#str}}photo_guide_3, local_studentid{{/str}}</li>
        <li>{{#str}}photo_guide_4, local_studentid{{/str}}</li>
        <li>{{#str}}photo_guide_5, local_studentid{{/str}}</li>
      </ul>
    </div>
  </div>
  {{/can_new_request}}

  {{#has_history}}
  <div class="card shadow-sm">
    <div class="card-header">
      <strong><span class="fa fa-history mr-1"></span>{{#str}}requesthistory, local_studentid{{/str}}</strong>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="thead-light">
          <tr>
            <th>#</th>
            <th>{{#str}}status, local_studentid{{/str}}</th>
            <th>{{#str}}timecreated, local_studentid{{/str}}</th>
            <th>{{#str}}timesubmitted, local_studentid{{/str}}</th>
            <th>{{#str}}comments, local_studentid{{/str}}</th>
          </tr>
        </thead>
        <tbody>
          {{#history}}
          <tr>
            <td><small class="text-muted">#{{id}}</small></td>
            <td><span class="{{statusclass}}">{{statuslabel}}</span></td>
            <td><small>{{timecreated}}</small></td>
            <td><small>{{timesubmitted}}</small></td>
            <td>
              {{#comment}}<small class="text-muted">{{comment}}</small>{{/comment}}
              {{^comment}}<small class="text-muted">&mdash;</small>{{/comment}}
            </td>
          </tr>
          {{/history}}
        </tbody>
      </table>
    </div>
  </div>
  {{/has_history}}

</div>

    {{#show_eye_icon}}
    <span class="live_join_class_eye" data-id="{{meeting_id}}" data-visible="{{toggle_visibility}}">
            <i class="icon fa {{eye_icon_class}} fa-fw" aria-hidden="true"></i>
        </span>
    {{/show_eye_icon}}

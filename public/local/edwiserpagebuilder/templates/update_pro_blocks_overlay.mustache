<style>
/* Smooth progress bar transitions */
#add-block-overlay-bar {
    transition: width 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: width;
    transform: translateZ(0); /* Force hardware acceleration */
}

.add-block-loading-placeholder {

    background-color: #fff;
    border-radius: 8px;
}

/* Overlay positioning */
.update-pro-blocks-overlay {
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;
    bottom: 0px;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.progress-bar-wrapper .progress {
    overflow: hidden;
}
</style>

<div class="update-pro-blocks-overlay" id="update-pro-blocks-overlay">
    <div class="add-block-loading-placeholder">
        <div class="text-center px-4 py-3" style="min-width:265.99px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="add-block-installing-placeholder-text">{{#str}}updatingproblocks,local_edwiserpagebuilder{{/str}}</span>
            </div>
            <div class="progress-bar-wrapper d-flex align-items-center">
                <div class="progress" style="flex: 1;">
                    <div id="add-block-overlay-bar" class="progress-bar bg-success" role="progressbar"
                        aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <span id="add-block-overlay-progress" class="ml-2">0%</span>
            </div>
        </div>
    </div>
</div>


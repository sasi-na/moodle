{{!
    @template theme_baz/front-landing

    Bespoke logged-out landing (gateway) for the site front page. A branded
    hero (the "Learn Beyond Borders" banner over the login-navy gradient) with a
    single "Log in to learn" button linking to the login page. Reuses the theme
    head/end-of-body scaffolding. Logged-in users get the standard front page.
}}
{{> theme_baz/head }}

<body {{{ bodyattributes }}}>
    {{> core/local/toast/wrapper}}
    {{{ output.standard_top_of_body_html }}}

    <div id="fl-root">
        <header class="fl-top">
            {{#haslogo}}<img class="fl-logo" src="{{logourl}}" alt="{{sitename}}">{{/haslogo}}
            {{^haslogo}}<span class="fl-logo-txt">{{sitename}}</span>{{/haslogo}}
        </header>

        <main class="fl-hero">
            <div class="fl-bannerwrap">
                <img class="fl-banner" src="{{bannerurl}}" alt="{{#str}}fl_banneralt, theme_baz{{/str}}">
                <a class="fl-login" href="{{loginurl}}">{{#str}}fl_loginbtn, theme_baz{{/str}}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
        </main>

        <footer class="fl-foot">{{brandcopyright}}</footer>

        {{! Required Moodle main-content placeholder — hidden. The standard front
            page renders into main_content; the bespoke gateway replaces it, but
            header() still needs this marker to slice the page correctly. }}
        <div id="region-main-box" class="fl-region-main">
            <section id="region-main" aria-label="{{#str}}content{{/str}}">{{{ output.main_content }}}</section>
        </div>
    </div>

    {{{ output.standard_end_of_body_html }}}
</body>
</html>
